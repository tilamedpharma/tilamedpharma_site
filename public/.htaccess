# TILAMED Pharma · Hostinger (Apache / LiteSpeed)
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Sur le vrai domaine seulement : HTTPS obligatoire + www (l'adresse sans www y renvoie).
  #    L'adresse provisoire de Hostinger (aperçu avant la bascule DNS) n'est pas redirigée.
  RewriteCond %{HTTP_HOST} ^(www\.)?tilamedpharma\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^tilamedpharma\.com$ [NC]
  RewriteRule ^ https://www.tilamedpharma.com%{REQUEST_URI} [R=301,L]

  # 2) Barre oblique finale pour les pages (le site est généré en dossiers : /usine/ → /usine/index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/ [R=301,L]
</IfModule>

# Sécurité
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Fichiers à ne jamais servir
<FilesMatch "(^\.|\.(md|mjs|ts|toml|log|bak)$)">
  Require all denied
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml font/ttf
</IfModule>

# Cache : fichiers versionnés d'Astro (nom avec empreinte) = 1 an ; médias = 1 semaine ; pages HTML = revalidées
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/avif "access plus 1 week"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType video/mp4 "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
# (cache long de /_astro et /media : voir les .htaccess de ces dossiers)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
