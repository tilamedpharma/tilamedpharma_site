# Dans /api, seuls les points d'entrée PHP sont accessibles ; bibliothèques (lib/), données générées (data/),
# modèle de configuration et éventuel config.php local ne doivent jamais être servis.
Options -Indexes
<FilesMatch ".*">
  Require all denied
</FilesMatch>
<FilesMatch "^(form|catalogue|fiche|sitemap)\.php$">
  Require all granted
</FilesMatch>
