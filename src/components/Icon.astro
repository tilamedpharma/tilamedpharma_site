---
// Jeu d'icônes linéaires maison (trait 1.75, 24×24). Les icônes de réseaux sociaux sont pleines.
import { iconStroke as stroke, iconFill as fill } from '../data/icons';
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 20, class: cls = '', label } = Astro.props;

const isFill = name in fill;
const body = isFill ? fill[name] : stroke[name] ?? stroke.plus;
---
<svg
  class={`icon ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  set:html={body}
/>
