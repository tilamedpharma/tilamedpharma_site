---
// Page « Actualités » : toutes les actualités, chacune avec son ancre (#a1, #a2…) depuis l'accueil.
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import PageHero from '../page/PageHero.astro';
import { useDict, formatDate } from '../../i18n';
import { useFin } from '../../i18n/pages/fin';
import { localizePath, type Locale } from '../../i18n/config';
import imgHero from '../../assets/images/stock/actualites-lecture-journal.jpg';
import imgN1 from '../../assets/images/stock/ingenieure-terrain-plans.jpg';
import imgN2 from '../../assets/images/stock/affaires-reunion-salle.jpg';
import imgN3 from '../../assets/images/stock/salle-propre-couloir-equipe.jpg';
import imgN4 from '../../assets/images/stock/affaires-equipe-ordinateur.jpg';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useDict(lang);
const n = useFin(lang).news;
const L = (s: string) => localizePath(lang, s);
const pages = t.nav.pages as Record<string, string>;
const articles = [
  ...t.news.items.map((it, i) => ({ date: it.date, tag: it.tag, title: it.title, body: n.bodies[i] })),
  ...n.extra,
].map((a, i) => ({ ...a, id: `a${i + 1}`, img: [imgN1, imgN2, imgN3, imgN4][i] }));
---
<PageHero lang={lang} section="medias" slug="actualites" title={pages['actualites']} lead={n.lead} image={imgHero} />

<section class="section mnews" aria-label={pages['actualites']}>
  <div class="wrap">
    <ol class="mnews__list">
      {articles.map((a, i) => (
        <li>
          <article class="mnews__item" id={a.id} data-reveal>
            <div class="mnews__img"><Picture src={a.img} formats={['avif', 'webp']} widths={[420, 720, 960]} sizes="(max-width: 900px) 92vw, 40vw" alt="" loading={i === 0 ? 'eager' : 'lazy'} /></div>
            <div class="mnews__body">
              <p class="news__meta"><span class="news__tag">{a.tag}</span><time datetime={a.date}>{formatDate(lang, a.date)}</time></p>
              <h2 class="mnews__t">{a.title}</h2>
              {a.body.map((p) => <p class="mnews__p">{p}</p>)}
            </div>
          </article>
        </li>
      ))}
    </ol>
    <div class="mnews__cta" data-reveal><a class="btn btn--ghost" href={L('presse')}>{n.pressCta}<Icon name="arrow" size={18} class="flip-rtl" /></a></div>
  </div>
</section>

