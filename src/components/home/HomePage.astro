---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import NetworkMap from './NetworkMap.astro';
// Logos officiels des référentiels (choix de l'utilisateur, 19/11/2026, informé des règles d'usage de l'OMS, de l'ISO et d'EDGE).
// BPF retiré des référentiels (19/11/2026). Ordre = t.compliance.standards (OMS, ISO, EDGE).
const stdLogos = ['/media/standards/oms.svg', '/media/standards/iso.svg', '/media/standards/edge.svg'];
import { useDict } from '../../i18n';
import { localizePath, localeMeta, type Locale } from '../../i18n/config';
import { suppliers, trustLogos } from '../../data/site';

import imgWhy from '../../assets/images/stock/perfusion-infirmiere-reglage.jpg';
import imgGreen from '../../assets/images/stock/green-toiture-solaire-industrielle.jpg';
import imgGreenTech from '../../assets/images/stock/green-technicien-solaire.jpg';
import imgIncl from '../../assets/images/stock/inclusion-femmes-metiers.jpg';
import imgInclInset from '../../assets/images/stock/inclusion-homme-fauteuil.jpg';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useDict(lang);
const L = (slug: string) => localizePath(lang, slug);
const pad = (n: number) => String(n).padStart(2, '0');

const words = t.hero.title.split(' ');
const rtl = localeMeta[lang].dir === 'rtl';
const whyIcons = ['truck', 'route', 'tag', 'users'];
---

<!-- HERO : slider à deux slides (vidéo de l'usine · carte animée du réseau). Logique dans scripts/site.ts. -->
<section class="hero" aria-labelledby="hero-title" aria-roledescription="carousel" aria-label={t.heroNet.label} data-hslider>
  <div class="hero__stage">
    <!-- Slide 1 : vidéo -->
    <div class="hero__slide hero__slide--video is-active" id="hslide-0" role="tabpanel" aria-labelledby="htab-0" data-slide="0">
      <div class="hero__media" aria-hidden="true">
        <video data-hero-video autoplay muted loop playsinline preload="metadata" poster="/media/video/hero-wide.jpg">
          <source src="/media/video/hero-wide.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="hero__body wrap">
        <div class="hero__content">
          <p class="hero__eyebrow hero__fade"><span class="hero__dot" aria-hidden="true"></span>{t.hero.eyebrow}</p>
          <h1 class="hero__title" id="hero-title">
            {words.map((w, i) => <><span class="w" style={`--i:${i}`}>{w}</span>{i < words.length - 1 ? ' ' : ''}</>)}
          </h1>
          <p class="hero__lead hero__fade">{t.hero.lead}</p>
          <div class="hero__ctas hero__fade hero__fade--2">
            <a class="btn" href={L('usine')}>{t.hero.cta1}<Icon name="arrow" size={18} class="flip-rtl" /></a>
            <a class="btn btn--outline-light" href={L('contact')}>{t.hero.cta2}</a>
          </div>
        </div>
      </div>
    </div>
    <!-- Slide 2 : carte animée du réseau (variante A) -->
    <div class="hero__slide hero__slide--net" id="hslide-1" role="tabpanel" aria-labelledby="htab-1" data-slide="1" aria-hidden="true">
      <div class="hero__media" aria-hidden="true"><NetworkMap variant="a" id="hero" side={rtl ? 'left' : 'right'} lang={lang} /></div>
      <div class="hero__body wrap">
        <div class="hero__content hero__content--net">
          <p class="hero__eyebrow"><span class="hero__dot" aria-hidden="true"></span>{t.heroNet.eyebrow}</p>
          <h2 class="hero__title hero__title--net">{t.heroNet.title}</h2>
          <p class="hero__lead">{t.heroNet.lead}</p>
          <p class="hero__count"><b data-nm-count dir="ltr">15</b><span>{t.heroNet.count}</span></p>
          <div class="hero__ctas">
            <a class="btn" href={L('presence')} tabindex="-1">{(t.nav.pages as Record<string, string>)['presence']}<Icon name="arrow" size={18} class="flip-rtl" /></a>
            <a class="btn btn--outline-light" href={L('distributeurs')} tabindex="-1">{t.clients.cta}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="hero__aside">
    <span class="hero__caption">{t.hero.caption}</span>
    <div class="hero__ctrl">
      <button class="hero__toggle hero__arrow" type="button" data-hero-prev aria-label={t.heroNet.prev} aria-controls="hslide-0 hslide-1">
        <Icon name="arrow" size={18} class="hero__arrow-back" />
      </button>
      <button class="hero__toggle" type="button" data-hero-toggle aria-label={t.a11y.pause} data-label-play={t.a11y.play} data-label-pause={t.a11y.pause}>
        <Icon name="pause" size={16} class="icon-pause" />
        <Icon name="play" size={16} class="icon-play" />
      </button>
      <button class="hero__toggle hero__arrow" type="button" data-hero-next aria-label={t.heroNet.next} aria-controls="hslide-0 hslide-1">
        <Icon name="arrow" size={18} class="flip-rtl" />
      </button>
    </div>
  </div>
  <div class="hero__band">
    <div class="hero__band-blue">
      <div class="hero__tabs" role="tablist" aria-label={t.heroNet.label}>
        {t.heroNet.tabs.map((label, i) => (
          <button class:list={['hero__tab', { 'is-active': i === 0 }]} type="button" role="tab" id={`htab-${i}`} aria-controls={`hslide-${i}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>
            <span class="hero__tab-n">{pad(i + 1)}</span>{label}<i class="hero__prog" aria-hidden="true"><i></i></i>
          </button>
        ))}
      </div>
    </div>
    <div class="hero__band-green"><p class="hero__slogan">{t.slogan}</p></div>
  </div>
</section>

<!-- NOTRE IMPACT (chiffres + green building) -->
<section class="section impact" aria-labelledby="impact-title">
  <div class="wrap">
    <div class="sec-head sec-head--split">
      <div>
        <p class="eyebrow" data-reveal><Icon name="leaf" size={16} class="eyebrow__leaf" /><span>{t.impact.eyebrow}</span></p>
        <h2 class="h2" id="impact-title" data-reveal>{t.impact.title}</h2>
        <span class="title-rule" aria-hidden="true"></span>
      </div>
      <p class="lead" data-reveal>{t.impact.intro}</p>
    </div>

    <div class="kpi" aria-label={t.figures.title}>
      <!-- Bandeau de 6 chiffres (gros chiffre, unité en capitales, description lisible) -->
      <!-- Les 2 premiers chiffres (capacité LVP + SVP) sont regroupés sous un même titre, reliés par un « + ». -->
      <div class="kband" data-reveal>
        <div class="kband__cap">
          <p class="kband__head"><Icon name="vial" size={16} />{t.impact.capacity.title}</p>
          <div class="kband__pair">
            {t.impact.band.slice(0, 2).map((b, i) => (
              <>
                {i > 0 && <span class="kband__and" aria-hidden="true">+</span>}
                <div class="kband__item">
                  <span class:list={['kband__code', { 'kband__code--svp': i > 0 }]}>{t.impact.capacity.items[i].code}</span>
                  <p class="kband__num"><span data-count={b.value}>{b.value}</span></p>
                  <p class="kband__unit">{b.unit}</p>
                  <p class="kband__text">{b.text}</p>
                </div>
              </>
            ))}
          </div>
        </div>
        {t.impact.band.slice(2).map((b) => (
          <div class="kband__item kband__item--solo">
            <p class="kband__num"><span data-count={b.value}>{b.value}</span>{b.plus && <span class="kband__plus">{b.plus}</span>}</p>
            <p class="kband__unit">{b.unit}</p>
            <p class="kband__text">{b.text}</p>
          </div>
        ))}
      </div>
      <div class="kpi__duo">
        {[{ f: t.figures.items[5], tone: 'blue', icon: 'users', href: L('egalite') }, { f: t.figures.items[4], tone: 'green', icon: 'leaf', href: L('environnement') }].map((k, i) => (
          <a class={`kpi__card kpi__card--${k.tone}`} href={k.href} data-reveal style={`--d:${i + 1}`}>
            <span class="kpi__icon"><Icon name={k.icon} size={24} /></span>
            <span class="kpi__text">
              <span class="kpi__big">{k.f.value}{k.f.unit && <small>{k.f.unit}</small>}</span>
              <span class="kpi__label">{k.f.label}</span>
            </span>
            <Icon name="arrow" size={20} class="kpi__arrow flip-rtl" />
          </a>
        ))}
      </div>
    </div>

    <div class="green">
      <div class="green__media" data-reveal="scale">
        <div class="green__img">
          <Picture src={imgGreen} formats={['avif', 'webp']} widths={[560, 900, 1300]} sizes="(max-width: 900px) 92vw, 48vw" alt={t.impact.imageAlt} loading="lazy" />
        </div>
        <div class="green__inset">
          <Picture src={imgGreenTech} formats={['avif', 'webp']} widths={[320, 520]} sizes="220px" alt={t.impact.techAlt} loading="lazy" />
        </div>
        <span class="green__badge"><Icon name="leaf" size={16} />{t.impact.badge}</span>
      </div>
      <div class="green__body">
        <h3 class="green__title" data-reveal>{t.impact.greenTitle}</h3>
        <p class="green__text" data-reveal>{t.impact.greenText}</p>
        <ul class="green__proofs" data-reveal>
          {t.impact.proofs.map((p) => <li><Icon name="check-circle" size={18} />{p}</li>)}
        </ul>
        <a class="link-arrow green__cta" href={L('environnement')} data-reveal>{t.impact.cta}<Icon name="arrow" size={16} class="flip-rtl" /></a>
      </div>
    </div>

    <div class="green green--incl">
      <div class="green__body">
        <h3 class="green__title" data-reveal>{t.impact.inclusion.title}</h3>
        <p class="green__text" data-reveal>{t.impact.inclusion.text}</p>
        <a class="link-arrow green__cta" href={L('egalite')} data-reveal>{t.impact.inclusion.cta}<Icon name="arrow" size={16} class="flip-rtl" /></a>
      </div>
      <div class="green__media" data-reveal="scale">
        <div class="green__img">
          <Picture src={imgIncl} formats={['avif', 'webp']} widths={[560, 900, 1300]} sizes="(max-width: 900px) 92vw, 48vw" alt={t.impact.inclusion.imageAlt} loading="lazy" />
        </div>
        <div class="green__inset">
          <Picture src={imgInclInset} formats={['avif', 'webp']} widths={[320, 520]} sizes="220px" alt={t.impact.inclusion.insetAlt} loading="lazy" />
        </div>
        <span class="green__badge"><Icon name="users" size={16} />{t.impact.inclusion.badge}</span>
      </div>
    </div>
  </div>
</section>

<!-- POURQUOI LE BÉNIN -->
<section class="section why" aria-labelledby="why-title">
  <div class="wrap why__grid">
    <div>
      <p class="eyebrow eyebrow--light" data-reveal><span class="eyebrow__n">01</span>·<span>{t.why.eyebrow}</span></p>
      <h2 class="h2" id="why-title" data-reveal>{t.why.title}</h2>
      <span class="title-rule" aria-hidden="true"></span>
      <div class="why__stat" data-reveal>
        <span class="why__big">{t.why.stat}</span>
        <span class="why__statlabel">{t.why.statLabel}</span>
      </div>
      <p class="why__text" data-reveal>{t.why.text}</p>
      <ul class="why__items">
        {t.why.items.map((it, i) => (
          <li class="why__item" data-reveal style={`--d:${i}`}>
            <Icon name={whyIcons[i]} size={26} />
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
    <figure class="why__visual" data-reveal="scale">
      <Picture src={imgWhy} formats={['avif', 'webp']} widths={[480, 760, 1040]} sizes="(max-width: 900px) 92vw, 44vw" alt={t.why.imageAlt} loading="lazy" />
      <figcaption><Icon name="pin" size={20} />{t.hero.proofs[1]}</figcaption>
    </figure>
  </div>
</section>

<!-- CHAÎNE DE DISTRIBUTION (animée) : usine → centrales / distributeurs → patients. Placée juste après « Pourquoi produire au Bénin ? » (demande client). -->
<section class="section dch" aria-labelledby="dch-title">
  <div class="wrap">
    <div class="sec-head sec-head--center">
      <p class="eyebrow" data-reveal><span class="eyebrow__n">02</span>·<span>{t.chain.eyebrow}</span></p>
      <h2 class="h2" id="dch-title" data-reveal>{t.chain.title}</h2>
      <span class="title-rule" aria-hidden="true"></span>
      <p class="lead" data-reveal>{t.chain.intro}</p>
    </div>
    <ol class="dch__chain" aria-label={t.chain.label} data-reveal="fade">
      {t.chain.steps.map((s, i) => (
        <>
          {i > 0 && (
            <li class="dch__link" style={`--k:${i}`} aria-hidden="true"><i></i><i></i><i></i></li>
          )}
          <li class={`dch__step dch__step--${i + 1}`} style={`--k:${i}`}>
            <span class="dch__node"><Icon name={['factory', 'truck', 'users'][i]} size={30} /><b class="dch__n">{i + 1}</b></span>
            <h3 class="dch__title">{s.title}</h3>
            <p class="dch__text">{s.text}</p>
          </li>
        </>
      ))}
    </ol>
    <div class="dch__foot" data-reveal>
      <p class="dch__badge"><span class="dch__badge-ic"><Icon name="clock" size={18} /></span><strong>{t.chain.badge.strong}</strong> {t.chain.badge.text}</p>
      <a class="btn btn--primary" href={L('chaine-distribution')}>{t.chain.cta}<Icon name="arrow" size={18} class="flip-rtl" /></a>
    </div>
  </div>
</section>

<!-- CONFORMITÉ -->
<section class="section comp" aria-labelledby="comp-title">
  <div class="wrap">
    <div class="sec-head sec-head--split">
      <div>
        <p class="eyebrow" data-reveal><span class="eyebrow__n">03</span>·<span>{t.compliance.eyebrow}</span></p>
        <h2 class="h2" id="comp-title" data-reveal>{t.compliance.title}</h2>
        <span class="title-rule" aria-hidden="true"></span>
      </div>
      <p class="lead" data-reveal>{t.compliance.intro}</p>
    </div>
    <!-- Intitulés seulement : références, dates et autorités sont sur la page Agréments (maison). -->
    <ul class="comp__list">
      {t.compliance.items.map((c, i) => (
        <li data-reveal style={`--d:${i % 3}`}><Icon name="check-circle" size={22} />{c.title}</li>
      ))}
    </ul>
    <div class="comp__std" data-reveal>
      <p class="comp__std-h">{t.compliance.standardsTitle}</p>
      <ul>
        {t.compliance.standards.map((s, i) => (
          <li class:list={[{ 'is-green': i === t.compliance.standards.length - 1 }]}>
            <span class="comp__std-top">
              <span class="comp__id">
                <span class="comp__logo"><img src={stdLogos[i]} alt="" width="120" height="56" loading="lazy" decoding="async" /></span>
                <span class="comp__code">{s.code}</span>
              </span>
              <span class="comp__st"><Icon name={i === 0 ? 'check-circle' : 'clock'} size={14} />{t.compliance.standardsStatus[i]}</span>
            </span>
            <p>{s.label}</p>
          </li>
        ))}
      </ul>
    </div>
    <div class="comp__cta" data-reveal>
      <a class="link-arrow" href={L('agrements')}>{(t.nav.pages as Record<string, string>)['agrements']}<Icon name="arrow" size={16} class="flip-rtl" /></a>
      <a class="link-arrow" href={L('qualite')}>{t.compliance.cta}<Icon name="arrow" size={16} class="flip-rtl" /></a>
    </div>
  </div>
</section>

<!-- CLIENTS -->
<section class="section cli" aria-labelledby="cli-title">
  <div class="wrap cli__grid">
    <div class="cli__side">
      <p class="eyebrow eyebrow--light" data-reveal><span class="eyebrow__n">04</span>·<span>{t.clients.eyebrow}</span></p>
      <h2 class="h2" id="cli-title" data-reveal>{t.clients.title}</h2>
      <span class="title-rule" aria-hidden="true"></span>
      <p class="lead" data-reveal>{t.cta.text}</p>
      <a class="btn btn--green" href={L('distributeurs')} data-reveal>{t.clients.cta}<Icon name="arrow" size={18} class="flip-rtl" /></a>
    </div>
    <!-- Types de clients seulement : les exemples (SOBAPS, CAMEG…) sont sur la page Nos clients (maison). -->
    <ol class="cli__rows">
      {t.clients.items.map((c, i) => (
        <li data-reveal style={`--d:${i}`}>
          <span class="cli__n">{pad(i + 1)}</span>
          <h3>{c.title}</h3>
        </li>
      ))}
      <li class="cli__more" data-reveal><a class="link-arrow link-arrow--light" href={L('clients')}>{(t.nav.pages as Record<string, string>)['clients']}<Icon name="arrow" size={16} class="flip-rtl" /></a></li>
    </ol>
  </div>
</section>

<!-- PARTENAIRES -->
<section class="section ptn" aria-labelledby="ptn-title">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow" data-reveal><span class="eyebrow__n">05</span>·<span>{t.partners.eyebrow}</span></p>
      <h2 class="h2" id="ptn-title" data-reveal>{t.partners.suppliersTitle}</h2>
      <span class="title-rule" aria-hidden="true"></span>
    </div>
    <div class="ptn__block" data-reveal>
      <div class="ptn__head"><p>{t.partners.suppliersText}</p></div>
      <ul class="ptn__logos">
        {suppliers.map((s) => (
          <li class="ptn__logo" title={s.name}>
            {s.logo ? <img src={s.logo} alt={s.name} loading="lazy" decoding="async" /> : <span class="ptn__word">{s.name}</span>}
          </li>
        ))}
      </ul>
    </div>
    <div class="ptn__block" data-reveal>
      <div class="ptn__head"><h3>{t.partners.trustTitle}</h3></div>
      <ul class="ptn__logos ptn__logos--trust">
        {t.partners.trust.map((n, i) => (
          <li class="ptn__logo" title={n}>
            {trustLogos[i] ? <img src={trustLogos[i]} alt={n} loading="lazy" decoding="async" /> : <span class="ptn__word ptn__word--sm">{n}</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
