---
// Page « Catalogue » : les 5 gammes + catalogue complet filtrable (recherche et gammes, sans rechargement).
// Les produits viennent de la base du back office : les emplacements <Live> sont remplis par public/api/catalogue.php.
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import PageHero from '../page/PageHero.astro';
import Live from './Live.astro';
import { useDict } from '../../i18n';
import { useCatalog } from '../../i18n/catalog';
import { useProduits } from '../../i18n/pages/produits';
import { localizePath, type Locale } from '../../i18n/config';
import type { Group } from '../../data/catalog';
import { productFamilies, catalogueImage } from '../../data/products';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useDict(lang);
const c = useCatalog(lang);
const p = useProduits(lang);
const L = (s: string) => localizePath(lang, s);
const pages = t.nav.pages as Record<string, string>;

const groups: Group[] = productFamilies.map((f) => f.group);
---
<PageHero lang={lang} section="produits" slug="produits" title={pages['produits']} lead={p.catalogue.lead} image={catalogueImage}>
  <a class="btn" href="#catalogue">{p.catalogue.searchTitle}<Icon name="arrow" size={18} class="flip-rtl" /></a>
  <a class="btn btn--outline-light" href={L('documentation')}>{p.ui.docCta}</a>
</PageHero>

<section class="section pfam" aria-labelledby="pfam-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="h2" id="pfam-title" data-reveal>{p.catalogue.familiesTitle}</h2>
      <span class="title-rule" aria-hidden="true"></span>
    </div>
    <ul class="pfam__grid">
      {productFamilies.map((f, i) => (
        <li data-reveal style={`--d:${i}`}>
          <a class="pfam__card" href={L(f.slug)}>
            <span class="pfam__img"><Picture src={f.card} formats={['avif', 'webp']} widths={[360, 560, 800]} sizes="(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 20vw" alt="" loading="lazy" /></span>
            <span class="pfam__body">
              <span class="pfam__ic"><Icon name={f.icon} size={20} /></span>
              <span class="pfam__t">{c.groups[f.group].label}</span>
              <span class="pfam__d">{c.groups[f.group].blurb}</span>
              <span class="pfam__n"><Live k={`count:${f.group}`} /> {c.ui.refs}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section pcat" id="catalogue" aria-labelledby="pcat-title" data-catalog>
  <div class="wrap">
    <div class="sec-head sec-head--split">
      <div>
        <h2 class="h2" id="pcat-title" data-reveal>{p.catalogue.searchTitle}</h2>
        <span class="title-rule" aria-hidden="true"></span>
      </div>
      <p class="lead" data-reveal>{p.catalogue.searchIntro}</p>
    </div>

    <div class="pcat__bar">
      <label class="pcat__search">
        <Icon name="search" size={20} />
        <span class="sr-only">{c.ui.searchLabel}</span>
        <input type="search" placeholder={c.ui.search} autocomplete="off" data-cat-q />
      </label>
      <div class="pcat__chips" role="group" aria-label={c.ui.searchLabel}>
        <button type="button" class="pcat__chip" aria-pressed="true" data-cat-g="">{c.ui.all} <span><Live k="n:all" /></span></button>
        {groups.map((g) => <button type="button" class="pcat__chip" aria-pressed="false" data-cat-g={g}>{c.groups[g].label} <span><Live k={`n:${g}`} /></span></button>)}
      </div>
      <p class="pcat__count" aria-live="polite" data-cat-count data-one={c.ui.results(1)} data-many={c.ui.results(999)}><Live k="results" /></p>
    </div>

    {groups.map((g) => (
      <div class="pcat__group" data-cat-group={g}>
        <h3 class="pcat__gh"><a href={L(productFamilies.find((f) => f.group === g)!.slug)}>{c.groups[g].label}<Icon name="arrow" size={16} class="flip-rtl" /></a></h3>
        <ul class="pcards">
          <Live k={`cards:${g}`} />
        </ul>
      </div>
    ))}

    <div class="pcat__none" hidden data-cat-none>
      <p class="pcat__none-t">{c.ui.none}</p>
      <p>{c.ui.noneHint}</p>
      <button type="button" class="btn btn--ghost btn--sm" data-cat-reset>{c.ui.reset}</button>
    </div>

    <ul class="pcat__legal">{c.ui.legal.map((x) => <li>{x}</li>)}</ul>
  </div>
</section>

