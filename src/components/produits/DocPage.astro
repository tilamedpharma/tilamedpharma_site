---
// Page « Demande de documentation » : formulaire (envoi via /api/form.php) + rappel des contacts.
import Icon from '../Icon.astro';
import PageHero from '../page/PageHero.astro';
import { useDict, countryName } from '../../i18n';
import { useCatalog } from '../../i18n/catalog';
import { useProduits } from '../../i18n/pages/produits';
import { type Locale } from '../../i18n/config';
import { company, offices, coverage } from '../../data/site';
import { productFamilies } from '../../data/products';
import imgDoc from '../../assets/images/stock/pharmacie-pharmacien.jpg';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useDict(lang);
const c = useCatalog(lang);
const p = useProduits(lang);
const f = p.doc.fields;
const pages = t.nav.pages as Record<string, string>;
const countries = [...coverage.map((x) => x.iso), 'FR'].map((iso) => ({ iso, name: countryName(lang, iso) })).sort((a, b) => a.name.localeCompare(b.name, lang));
---
<PageHero lang={lang} section="produits" slug="documentation" title={pages['documentation']} lead={p.doc.lead} image={imgDoc} />

<section class="section pdoc" aria-labelledby="pdoc-title">
  <div class="wrap stepc__grid">
    <div>
      <p class="eyebrow" data-reveal><Icon name="download" size={16} class="eyebrow__ic" /><span>{pages['documentation']}</span></p>
      <h2 class="h2" id="pdoc-title" data-reveal>{p.doc.formTitle}</h2>
      <span class="title-rule" aria-hidden="true"></span>
      <p class="lead stepc__intro" data-reveal>{p.doc.intro}</p>

      <form class="form" name="documentation" method="POST" action="/api/form.php" data-form data-msg-sending={t.formMsg.sending} data-msg-ok={t.formMsg.ok} data-msg-error={t.formMsg.error} data-msg-big={t.formMsg.big}>
        <input type="hidden" name="form-name" value="documentation" />
        <input type="hidden" name="langue" value={lang} />
        <p hidden><label>Ne pas remplir <input name="bot-field" /></label></p>
        <div class="form__row">
          <label class="field"><span>{f.name} <b aria-hidden="true">*</b></span><input name="nom" required autocomplete="name" /></label>
          <label class="field"><span>{f.org} <b aria-hidden="true">*</b></span><input name="organisation" required autocomplete="organization" /></label>
        </div>
        <div class="form__row">
          <label class="field"><span>{f.profile} <b aria-hidden="true">*</b></span>
            <select name="profil" required>
              <option value="">{f.select}</option>
              {p.doc.profiles.map((x) => <option>{x}</option>)}
            </select>
          </label>
          <label class="field"><span>{f.country} <b aria-hidden="true">*</b></span>
            <select name="pays" required>
              <option value="">{f.select}</option>
              {countries.map((x) => <option value={x.iso}>{x.name}</option>)}
            </select>
          </label>
        </div>
        <div class="form__row">
          <label class="field"><span>{f.email} <b aria-hidden="true">*</b></span><input type="email" name="email" required autocomplete="email" /></label>
          <label class="field"><span>{f.phone}</span><input type="tel" name="telephone" autocomplete="tel" dir="ltr" /></label>
        </div>
        <fieldset class="field field--set">
          <legend>{f.ranges}</legend>
          <div class="checks">
            {productFamilies.map((x) => (
              <label class="check"><input type="checkbox" name="gammes[]" value={x.group} /><span><Icon name={x.icon} size={18} />{c.groups[x.group].label}</span></label>
            ))}
          </div>
        </fieldset>
        <label class="field"><span>{f.products}</span><input name="produits" placeholder={f.productsHint} /></label>
        <label class="field"><span>{f.message}</span><textarea name="message" rows="5"></textarea></label>
        <label class="check check--consent"><input type="checkbox" name="consentement" required /><span>{f.consent}</span></label>
        <button class="btn" type="submit">{f.submit}<Icon name="arrow" size={18} class="flip-rtl" /></button>
        <p class="form__status" role="status" aria-live="polite" hidden></p>
        <p class="form__req"><b aria-hidden="true">*</b> {f.required}</p>
      </form>
    </div>

    <aside class="stepc__aside">
      <div class="sfacts" data-reveal>
        <p class="sfacts__h">{p.doc.asideTitle}</p>
        <ul class="pdoc__list">{p.doc.asideItems.map((x) => <li><Icon name="check" size={18} />{x}</li>)}</ul>
      </div>
      <div class="sdoc" data-reveal>
        <span class="sdoc__t">{p.doc.direct}</span>
        <a class="pdoc__contact" href={`mailto:${company.email}`}><Icon name="mail" size={18} />{company.email}</a>
        <a class="pdoc__contact" href={`tel:${offices[0].tel}`} dir="ltr"><Icon name="phone" size={18} />{offices[0].phone}</a>
      </div>
      <p class="pcat__legal pcat__legal--aside">{c.ui.legal[1]}</p>
    </aside>
  </div>
</section>

