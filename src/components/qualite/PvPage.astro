---
// Page « Pharmacovigilance » : avertissement d'urgence + formulaire de signalement (envoi via /api/form.php).
import Icon from '../Icon.astro';
import PageHero from '../page/PageHero.astro';
import { useDict, countryName } from '../../i18n';
import { useQualite } from '../../i18n/pages/qualite';
import { type Locale } from '../../i18n/config';
import { company, offices, coverage } from '../../data/site';
import imgPv from '../../assets/images/stock/pharmacie-rayons.jpg';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useDict(lang);
const q = useQualite(lang).pv;
const f = q.fields;
const pages = t.nav.pages as Record<string, string>;
const countries = [...coverage.map((x) => x.iso), 'FR'].map((iso) => ({ iso, name: countryName(lang, iso) })).sort((a, b) => a.name.localeCompare(b.name, lang));
---
<PageHero lang={lang} section="qualite" slug="pharmacovigilance" title={pages['pharmacovigilance']} lead={q.lead} image={imgPv} />

<section class="section pdoc" aria-labelledby="pv-title">
  <div class="wrap stepc__grid">
    <div>
      <p class="pv__urgent" data-reveal><Icon name="phone" size={22} /><strong>{q.emergency}</strong></p>
      <h2 class="h2" id="pv-title" data-reveal>{q.formTitle}</h2>
      <span class="title-rule" aria-hidden="true"></span>
      <p class="lead stepc__intro" data-reveal>{q.intro}</p>

      <form class="form" name="pharmacovigilance" method="POST" action="/api/form.php" data-form data-msg-sending={t.formMsg.sending} data-msg-ok={t.formMsg.ok} data-msg-error={t.formMsg.error} data-msg-big={t.formMsg.big}>
        <input type="hidden" name="form-name" value="pharmacovigilance" />
        <input type="hidden" name="langue" value={lang} />
        <p hidden><label>Ne pas remplir <input name="bot-field" /></label></p>
        <div class="form__row">
          <label class="field"><span>{f.reporter} <b aria-hidden="true">*</b></span>
            <select name="declarant" required><option value="">{f.select}</option>{q.reporters.map((x) => <option>{x}</option>)}</select>
          </label>
          <label class="field"><span>{f.type} <b aria-hidden="true">*</b></span>
            <select name="type" required><option value="">{f.select}</option>{q.types.map((x) => <option>{x}</option>)}</select>
          </label>
        </div>
        <div class="form__row">
          <label class="field"><span>{f.name} <b aria-hidden="true">*</b></span><input name="nom" required autocomplete="name" /></label>
          <label class="field"><span>{f.country}</span>
            <select name="pays"><option value="">{f.select}</option>{countries.map((x) => <option value={x.iso}>{x.name}</option>)}</select>
          </label>
        </div>
        <div class="form__row">
          <label class="field"><span>{f.email} <b aria-hidden="true">*</b></span><input type="email" name="email" required autocomplete="email" /></label>
          <label class="field"><span>{f.phone}</span><input type="tel" name="telephone" autocomplete="tel" dir="ltr" /></label>
        </div>
        <label class="field"><span>{f.product} <b aria-hidden="true">*</b></span><input name="produit" required /></label>
        <div class="form__row form__row--3">
          <label class="field"><span>{f.batch}</span><input name="lot" dir="ltr" /></label>
          <label class="field"><span>{f.expiry}</span><input type="month" name="peremption" /></label>
          <label class="field"><span>{f.date}</span><input type="date" name="date_evenement" /></label>
        </div>
        <label class="field"><span>{f.description} <b aria-hidden="true">*</b></span><textarea name="description" rows="6" required placeholder={f.descriptionHint}></textarea></label>
        <label class="check check--consent"><input type="checkbox" name="consentement" required /><span>{f.consent}</span></label>
        <button class="btn" type="submit">{f.submit}<Icon name="arrow" size={18} class="flip-rtl" /></button>
        <p class="form__status" role="status" aria-live="polite" hidden></p>
        <p class="form__req"><b aria-hidden="true">*</b> {f.required}</p>
      </form>
    </div>

    <aside class="stepc__aside">
      <div class="sfacts" data-reveal>
        <p class="sfacts__h">{q.asideTitle}</p>
        <ul class="pdoc__list">{q.asideItems.map((x) => <li><Icon name="check" size={18} />{x}</li>)}</ul>
      </div>
      <div class="sdoc" data-reveal>
        <span class="sdoc__t">{t.header.cta}</span>
        <a class="pdoc__contact" href={`mailto:${company.email}`}><Icon name="mail" size={18} />{company.email}</a>
        <a class="pdoc__contact" href={`tel:${offices[0].tel}`} dir="ltr"><Icon name="phone" size={18} />{offices[0].phone}</a>
      </div>
    </aside>
  </div>
</section>

