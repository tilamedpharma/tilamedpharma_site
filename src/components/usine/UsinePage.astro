---
// Page « Notre usine » (page de rubrique Usine) : vue d'ensemble + portail vers les pages détaillées.
// Dé-dupliquée le 18/11/2026 (voir CONTENT-MAP.md) : les blocs soufflage-remplissage-scellage, salles propres,
// laboratoire, utilités, transfert et emplacement, recopiés des pages détaillées, sont remplacés par des renvois.
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import PageHero from '../page/PageHero.astro';
import { useDict } from '../../i18n';
import { useUsine } from '../../i18n/pages/usine';
import { getTopic } from '../../i18n/pages/topics';
import { localizePath, type Locale } from '../../i18n/config';
import { processSteps } from '../../data/site';

import imgSite from '../../assets/images/stock/equipement-inox-usine.jpg';
import imgGreen from '../../assets/images/stock/green-usine-solaire-champs.jpg';
import imgExSalles from '../../assets/images/stock/salle-propre-couloir-chariot.jpg';
import imgExUtil from '../../assets/images/stock/utilites-compresseurs.jpg';
import imgExTransfert from '../../assets/images/stock/transfert-technicien-machine.jpg';
import imgExSite from '../../assets/images/stock/route-camion-verdure.jpg';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useDict(lang);
const u = useUsine(lang);
const L = (slug: string) => localizePath(lang, slug);
const pad = (n: number) => String(n).padStart(2, '0');
const pages = t.nav.pages as Record<string, string>;

const stepSlugs = processSteps.map((s) => s.slug);
// Les vidéos des étapes ne sont qu'en en-tête de leur page (une image = un seul endroit, 19/11/2026) :
// ici, chaque étape a un panneau numéroté avec une icône.
const stepVideos = processSteps.map((s) => s.video);
// Renvois : titre = nom de la page, texte = chapô de la page cible, visuel propre à la carte (pas l'en-tête de la cible).
const explore = [
  { slug: 'salles-propres', icon: 'filter', img: imgExSalles },
  { slug: 'utilites', icon: 'gauge', img: imgExUtil },
  { slug: 'transfert-technologie', icon: 'users', img: imgExTransfert },
  { slug: 'site-seme-podji', icon: 'pin', img: imgExSite },
].map((x) => ({ ...x, lead: getTopic(lang, x.slug).lead }));

// Métiers : les six familles viennent de la page « Nos métiers » (maison), ici en simple sommaire.
const jobBlock = getTopic(lang, 'metiers').blocks.find((b) => b.kind === 'cards') as { items: { title: string }[] } | undefined;
const jobIcons = ['factory', 'shield', 'flask', 'wrench', 'truck', 'users'];
const jobFamilies = (jobBlock?.items ?? []).map((x, i) => ({ title: x.title, icon: jobIcons[i] ?? 'users' }));
const visitHref = `${L('contact')}?objet=visite`;
const faqLink = (slug: string) => (slug === 'contact' ? visitHref : L(slug));
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: u.faq.items.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })) };
---
<PageHero lang={lang} section="usine" slug="usine" title={u.hero.title} lead={u.hero.lead} video="ligne-remplissage">
  <a class="btn" href="#procede">{u.hero.cta1}<Icon name="arrow" size={18} class="flip-rtl" /></a>
  <a class="btn btn--outline-light" href={L('site-seme-podji')}>{u.hero.cta2}</a>
</PageHero>

<!-- CHIFFRES (maison de la capacité de production) -->
<section class="ufacts pfacts ufacts--kpi" aria-label={u.hero.title}>
  <div class="wrap">
    <ul class="ufacts__list">
      {u.facts.map((f, i) => (
        <li data-reveal style={`--d:${i}`}>
          {f.code ? <span class:list={['ufacts__code', { 'is-green': f.code === 'SVP' }]}>{f.code}</span> : <span class="ufacts__code ufacts__code--blank" aria-hidden="true"></span>}
          {/* Même présentation que le bandeau de chiffres de l'accueil : chiffre, unité en capitales, trait vert, texte */}
          <p class="ufacts__num" dir="ltr">{f.value}</p>
          {f.unit && <p class="ufacts__unit">{f.unit}</p>}
          <p class="ufacts__label">{f.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- UN SITE INTÉGRÉ -->
<section class="section usite" aria-labelledby="usite-title">
  <div class="wrap usite__grid">
    <div>
      <p class="eyebrow" data-reveal><Icon name="factory" size={16} class="eyebrow__ic" /><span>{u.site.eyebrow}</span></p>
      <h2 class="h2" id="usite-title" data-reveal>{u.site.title}</h2>
      <span class="title-rule" aria-hidden="true"></span>
      <p class="lead usite__text" data-reveal>{u.site.text}</p>
    </div>
    <figure class="usite__visual" data-reveal="scale">
      <Picture src={imgSite} formats={['avif', 'webp']} widths={[480, 760, 1040]} sizes="(max-width: 900px) 92vw, 44vw" alt={u.site.imageAlt} loading="lazy" />
      <figcaption><Icon name="sparkle" size={20} />{u.site.badge}</figcaption>
    </figure>
  </div>
</section>

<!-- DEUX LIGNES : grands volumes (LVP) et petits volumes (SVP) -->
<section class="section ulines" aria-labelledby="ulines-title">
  <div class="wrap">
    <div class="sec-head sec-head--split">
      <div>
        <p class="eyebrow eyebrow--light" data-reveal><Icon name="layers" size={16} class="eyebrow__ic" /><span>{u.lines.eyebrow}</span></p>
        <h2 class="h2" id="ulines-title" data-reveal>{u.lines.title}</h2>
        <span class="title-rule" aria-hidden="true"></span>
      </div>
      <p class="lead" data-reveal>{u.lines.intro}</p>
    </div>
    <ul class="ulines__grid">
      {u.lines.items.map((x, i) => (
        <li class="ulines__card" data-reveal style={`--d:${i}`}>
          <div class="ulines__top">
            <div>
              <span class="ufacts__code">{x.code}</span>
              <span class="ulines__start"><Icon name="check" size={14} />{u.lines.start}</span>
              <h3 class="ulines__name">{x.name}</h3>
              <p class="ulines__sub">{x.sub}</p>
            </div>
            {i === 0 ? (
              <svg class="ulines__art" viewBox="0 0 80 120" aria-hidden="true">
                <path class="ulines__glass" d="M30 6h20v8l-4 6v6l14 10v68a10 10 0 0 1-10 10H30a10 10 0 0 1-10-10V36l14-10v-6l-4-6z" />
                <path class="ulines__liquid" d="M22 60c8-4 14 4 22 0s12-4 14 0v44a8 8 0 0 1-8 8H30a8 8 0 0 1-8-8z" />
                <path class="ulines__mark" d="M28 50h10M28 70h10M28 90h10" />
              </svg>
            ) : (
              <svg class="ulines__art ulines__art--amp" viewBox="0 0 80 120" aria-hidden="true">
                <path class="ulines__glass" d="M36 4h8l2 18c0 6-6 8-6 14s10 8 10 16v54a8 8 0 0 1-8 8h-4a8 8 0 0 1-8-8V52c0-8 10-10 10-16s-6-8-6-14z" />
                <path class="ulines__liquid" d="M32 74c4-2 8 2 12 0s4-2 4 0v32a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6z" />
                <path class="ulines__mark" d="M33 40h14" />
              </svg>
            )}
          </div>
          <dl class="ulines__rows">
            <div><dt>{u.lines.labels.container}</dt><dd>{x.container}</dd></div>
            <div><dt>{u.lines.labels.volumes}</dt><dd dir="auto">{x.volumes}</dd></div>
            <div><dt>{u.lines.labels.capacity}</dt><dd>{x.capacity}</dd></div>
            <div><dt>{u.lines.labels.uses}</dt><dd>{x.uses}</dd></div>
          </dl>
          <a class="link-arrow ulines__link" href={L(x.link)}>{x.cta}<Icon name="arrow" size={16} class="flip-rtl" /></a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- LE PROCÉDÉ EN 7 ÉTAPES -->
<section class="section usteps" id="procede" aria-labelledby="usteps-title">
  <div class="wrap">
    <div class="sec-head sec-head--split">
      <div>
        <p class="eyebrow" data-reveal><Icon name="route" size={16} class="eyebrow__ic" /><span>{u.process.eyebrow}</span></p>
        <h2 class="h2" id="usteps-title" data-reveal>{u.process.title}</h2>
        <span class="title-rule" aria-hidden="true"></span>
      </div>
      <p class="lead" data-reveal>{u.process.intro}</p>
    </div>
    <ol class="usteps__grid">
      {u.process.steps.map((s, i) => (
        <li class="ustep" data-reveal style={`--d:${i % 2}`}>
          <a class="ustep__link" href={L(stepSlugs[i])}>
            <span class="ustep__media" data-hover-play>
              <video muted loop playsinline preload="none" poster={`/media/video/${stepVideos[i]}.jpg`} aria-hidden="true">
                <source src={`/media/video/${stepVideos[i]}.mp4`} type="video/mp4" />
              </video>
              <span class="ustep__n"><small>{t.page.step}</small>{pad(i + 1)}</span>
            </span>
            <span class="ustep__body">
              <span class="ustep__t">{s.title}</span>
              <span class="ustep__d">{s.text}</span>
              <span class="ustep__pts">
                {s.points.map((p) => <span><Icon name="check" size={16} />{p}</span>)}
              </span>
              <span class="link-arrow">{u.process.more}<Icon name="arrow" size={16} class="flip-rtl" /></span>
            </span>
          </a>
        </li>
      ))}
      <li class="ustep ustep--cta" data-reveal style="--d:1">
        <a class="ustep__link" href={L('documentation')}>
          <span class="ustep__doc"><Icon name="download" size={28} /></span>
          <span class="ustep__t">{u.process.docTitle}</span>
          <span class="ustep__d">{u.process.docText}</span>
          <span class="link-arrow">{u.process.docCta}<Icon name="arrow" size={16} class="flip-rtl" /></span>
        </a>
      </li>
    </ol>
  </div>
</section>

<!-- SCHÉMA ANIMÉ DES FLUX (marche en avant) -->
<section class="section uflow" aria-labelledby="uflow-title" data-uflow data-active="all">
  <div class="wrap">
    <div class="sec-head sec-head--split">
      <div>
        <p class="eyebrow" data-reveal><Icon name="route" size={16} class="eyebrow__ic" /><span>{u.flows.eyebrow}</span></p>
        <h2 class="h2" id="uflow-title" data-reveal>{u.flows.title}</h2>
        <span class="title-rule" aria-hidden="true"></span>
      </div>
      <p class="lead" data-reveal>{u.flows.intro}</p>
    </div>
    <div class="uflow__bar" data-reveal>
      <div class="uflow__tabs" role="group" aria-label={u.flows.show}>
        <button type="button" class="uflow__tab" data-flow-btn="all" aria-pressed="true">{u.flows.all}</button>
        {u.flows.items.map((f) => (
          <button type="button" class:list={['uflow__tab', `is-${f.key}`]} data-flow-btn={f.key} aria-pressed="false"><Icon name={f.icon} size={16} />{f.title}</button>
        ))}
      </div>
      <ul class="uflow__legend">
        {(['g', 'c', 'a'] as const).map((z) => <li><span class={`uflow__sw z-${z}`} aria-hidden="true"></span>{u.flows.zones[z]}</li>)}
      </ul>
    </div>
    <ol class="uflow__lanes" data-reveal>
      {u.flows.items.map((f, i) => (
        <li class:list={['uflow__lane', `is-${f.key}`]} data-flow={f.key} style={`--n:${f.steps.length};--i:${i}`}>
          <p class="uflow__head"><span class="uflow__ic"><Icon name={f.icon} size={20} /></span>{f.title}</p>
          <div class="uflow__track">
            <span class="uflow__pulse" aria-hidden="true"></span>
            <ol class="uflow__steps">
              {f.steps.map((s) => (
                <li class={`uflow__st z-${s.z}`}><span>{s.t}</span><span class="sr-only"> · {u.flows.zones[s.z as 'g' | 'c' | 'a']}</span></li>
              ))}
            </ol>
          </div>
        </li>
      ))}
    </ol>
    <p class="uflow__note" data-reveal>{u.flows.note} <a class="link-arrow" href={L('site-seme-podji')}>{u.flows.cta}<Icon name="arrow" size={16} class="flip-rtl" /></a></p>
  </div>
</section>

<!-- AUTOUR DE LA PRODUCTION : renvois vers les pages détaillées -->
<section class="section vcom" aria-labelledby="uexp-title">
  <div class="wrap">
    <div class="sec-head sec-head--split">
      <div>
        <p class="eyebrow" data-reveal><Icon name="layers" size={16} class="eyebrow__ic" /><span>{u.explore.eyebrow}</span></p>
        <h2 class="h2" id="uexp-title" data-reveal>{u.explore.title}</h2>
        <span class="title-rule" aria-hidden="true"></span>
      </div>
      <p class="lead" data-reveal>{u.explore.intro}</p>
    </div>
    <ul class="vcom__grid uexp__grid">
      {explore.map((x, i) => (
        <li data-reveal style={`--d:${i}`}>
          <a class="vcom__card" href={L(x.slug)}>
            <div class="vcom__img"><Picture src={x.img} formats={['avif', 'webp']} widths={[400, 640, 900]} sizes="(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 24vw" alt="" loading="lazy" /></div>
            <div class="vcom__body">
              <span class="vcom__ic"><Icon name={x.icon} size={22} /></span>
              <h3>{pages[x.slug]}</h3>
              <p>{x.lead}</p>
              <span class="link-arrow">{u.explore.more}<Icon name="arrow" size={16} class="flip-rtl" /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- CE QUI SORTIRA DE NOS LIGNES (renvois vers les gammes fabriquées) -->
<section class="section uprod" aria-labelledby="uprod-title">
  <div class="wrap">
    <div class="sec-head sec-head--split">
      <div>
        <p class="eyebrow" data-reveal><Icon name="vial" size={16} class="eyebrow__ic" /><span>{u.products.eyebrow}</span></p>
        <h2 class="h2" id="uprod-title" data-reveal>{u.products.title}</h2>
        <span class="title-rule" aria-hidden="true"></span>
      </div>
      <p class="lead" data-reveal>{u.products.intro}</p>
    </div>
    <ul class="uprod__grid">
      {u.products.items.map((x, i) => (
        <li data-reveal style={`--d:${i}`}>
          <a class="uprod__card" href={L(x.slug)}>
            <span class="uprod__top">
              <span class="uprod__ic"><Icon name={x.icon} size={24} /></span>
              <span class="uprod__badge"><Icon name="clock" size={14} />{u.products.badge}</span>
            </span>
            <span class="uprod__tag">{x.tag}</span>
            <span class="uprod__t">{pages[x.slug]}</span>
            <span class="uprod__d">{x.text}</span>
            <span class="uprod__ex">{x.examples.map((e) => <span>{e}</span>)}</span>
            <span class="link-arrow">{u.products.more}<Icon name="arrow" size={16} class="flip-rtl" /></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="uprod__actions" data-reveal>
      <a class="btn" href={L('produits')}>{u.products.cta}<Icon name="arrow" size={18} class="flip-rtl" /></a>
      <a class="btn btn--ghost" href={L('documentation')}>{u.products.doc}</a>
    </div>
  </div>
</section>

<!-- LES MÉTIERS DE L'USINE (sommaire ; maison = page Nos métiers) -->
<section class="section ujobs" aria-labelledby="ujobs-title">
  <div class="wrap ujobs__grid">
    <div>
      <p class="eyebrow" data-reveal><Icon name="users" size={16} class="eyebrow__ic" /><span>{u.jobs.eyebrow}</span></p>
      <h2 class="h2" id="ujobs-title" data-reveal>{u.jobs.title}</h2>
      <span class="title-rule" aria-hidden="true"></span>
      <p class="lead ujobs__text" data-reveal>{u.jobs.text}</p>
      <div class="ujobs__ctas" data-reveal>
        <a class="btn" href={L('metiers')}>{u.jobs.cta1}<Icon name="arrow" size={18} class="flip-rtl" /></a>
        <a class="btn btn--ghost" href={L('candidature')}>{u.jobs.cta2}</a>
      </div>
    </div>
    <div class="ujobs__panel" data-reveal="scale">
      <p class="ujobs__num"><b dir="ltr">{u.jobs.value}</b><span>{u.jobs.unit}</span></p>
      <div class="ujobs__bar" aria-hidden="true">
        {u.jobs.split.map((s, i) => <span class={`is-${i}`} style={`--w:${s.v}%`}></span>)}
      </div>
      <ul class="ujobs__split">
        {u.jobs.split.map((s, i) => <li class={`is-${i}`}><b dir="ltr">{s.v} %</b>{s.l}</li>)}
      </ul>
      <p class="ujobs__ft">{u.jobs.familiesTitle}</p>
      <ul class="ujobs__fams">
        {jobFamilies.map((x) => <li><Icon name={x.icon} size={18} />{x.title}</li>)}
      </ul>
    </div>
  </div>
</section>

<!-- USINE VERTE (renvoi vers Environnement) -->
<section class="ugreen" aria-labelledby="ugreen-title">
  <div class="wrap">
    <div class="ugreen__card" data-reveal>
      <div class="ugreen__body">
        <span class="ugreen__badge"><Icon name="leaf" size={16} />{u.green.badge}</span>
        <h2 class="ugreen__title" id="ugreen-title">{u.green.title}</h2>
        <p>{u.green.text}</p>
        <a class="btn btn--light" href={L('environnement')}>{u.green.cta}<Icon name="arrow" size={18} class="flip-rtl" /></a>
      </div>
      <div class="ugreen__img">
        <Picture src={imgGreen} formats={['avif', 'webp']} widths={[480, 760, 1040]} sizes="(max-width: 900px) 92vw, 40vw" alt={u.green.imageAlt} loading="lazy" />
      </div>
    </div>
  </div>
</section>

<!-- FAQ DE L'USINE -->
<section class="section ufaq" aria-labelledby="ufaq-title">
  <div class="wrap ufaq__grid">
    <div class="ufaq__head">
      <p class="eyebrow" data-reveal><Icon name="book" size={16} class="eyebrow__ic" /><span>{u.faq.eyebrow}</span></p>
      <h2 class="h2" id="ufaq-title" data-reveal>{u.faq.title}</h2>
      <span class="title-rule" aria-hidden="true"></span>
      <p class="ufaq__all" data-reveal><a class="link-arrow" href={L('faq')}>{pages['faq']}<Icon name="arrow" size={16} class="flip-rtl" /></a></p>
    </div>
    <div class="mfaq__list ufaq__list">
      {u.faq.items.map((x, i) => (
        <details class="mfaq__item" data-reveal style={`--d:${i % 3}`} open={i === 0}>
          <summary><span>{x.q}</span><Icon name="plus" size={20} class="mfaq__plus" /></summary>
          <div class="mfaq__a">
            <p>{x.a}</p>
            <a class="link-arrow" href={faqLink(x.link)}>{u.faq.more}<Icon name="arrow" size={16} class="flip-rtl" /></a>
          </div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>

<!-- VISITER / S'ASSOCIER -->
<section class="section uvisit" aria-labelledby="uvisit-title">
  <div class="wrap">
    <div class="uvisit__card" data-reveal>
      <div class="uvisit__body">
        <span class="ugreen__badge"><Icon name="pin" size={16} />{u.visit.badge}</span>
        <h2 class="ugreen__title" id="uvisit-title">{u.visit.title}</h2>
        <p>{u.visit.text}</p>
      </div>
      <div class="uvisit__ctas">
        <a class="btn btn--light" href={visitHref}>{u.visit.cta1}<Icon name="arrow" size={18} class="flip-rtl" /></a>
        <a class="btn btn--outline-light" href={L('distributeurs')}>{u.visit.cta2}</a>
      </div>
    </div>
  </div>
</section>

<script>
  // Schéma des flux : un bouton met un flux en avant (les autres s'estompent).
  document.querySelectorAll<HTMLElement>('[data-uflow]').forEach((root) => {
    const btns = root.querySelectorAll<HTMLButtonElement>('[data-flow-btn]');
    btns.forEach((b) => b.addEventListener('click', () => {
      root.dataset.active = b.dataset.flowBtn;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }));
  });
</script>
