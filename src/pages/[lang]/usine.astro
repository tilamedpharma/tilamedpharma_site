---
import Base from '../../layouts/Base.astro';
import UsinePage from '../../components/usine/UsinePage.astro';
import { useUsine } from '../../i18n/pages/usine';
import { locales, defaultLocale, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return locales.filter((l) => l !== defaultLocale).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const u = useUsine(lang);
---
<Base lang={lang} slug="usine" title={u.meta.title} description={u.meta.description} image="/media/video/ligne-remplissage.jpg">
  <UsinePage lang={lang} />
</Base>
