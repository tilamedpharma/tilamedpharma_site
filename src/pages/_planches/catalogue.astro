<script is:inline>
(() => {
  const norm = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const arrowL = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>';
  const arrowR = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
  const seq = (cur, n) => {
    if (n <= 7) return Array.from({ length: n }, (_, i) => i + 1);
    const s = new Set([1, n, cur - 1, cur, cur + 1]);
    if (cur <= 3) [2, 3, 4].forEach((x) => s.add(x));
    if (cur >= n - 2) [n - 1, n - 2, n - 3].forEach((x) => s.add(x));
    const a = [...s].filter((x) => x >= 1 && x <= n).sort((x, y) => x - y);
    const out = [];
    a.forEach((x, i) => { if (i && x - a[i - 1] > 1) out.push('…'); out.push(x); });
    return out;
  };

  document.querySelectorAll('[data-demo]').forEach((root) => {
    const list = root.querySelector('[data-list]');
    const items = [...list.querySelectorAll('[data-item]')];
    items.forEach((el, i) => (el.dataset.i = i));
    const st = { g: '', c: '', q: '', sort: '', per: +root.dataset.per, page: 1 };

    const filtered = () => {
      const r = items.filter((el) => (!st.g || el.dataset.g === st.g) && (!st.c || el.dataset.c === st.c) && (!st.q || el.dataset.s.includes(st.q)));
      if (st.sort === 'az') r.sort((a, b) => a.dataset.n.localeCompare(b.dataset.n, 'fr'));
      else if (st.sort === 'za') r.sort((a, b) => b.dataset.n.localeCompare(a.dataset.n, 'fr'));
      else r.sort((a, b) => a.dataset.i - b.dataset.i);
      return r;
    };

    const btn = (label, page, cls = '', cur = false, dis = false) =>
      `<button type="button" class="${cls}" data-go="${page}"${cur ? ' aria-current="page"' : ''}${dis ? ' disabled' : ''} aria-label="${cls.includes('nav') || cls.includes('arrow') ? (page < st.page ? 'Page précédente' : 'Page suivante') : 'Page ' + page}">${label}</button>`;

    const renderPages = (n, pages) => {
      const kind = n.dataset.pages;
      const p = st.page;
      if (kind === 'num') {
        n.innerHTML = btn(arrowL + 'Précédent', p - 1, 'pag-nav', false, p === 1)
          + seq(p, pages).map((x) => (x === '…' ? '<span class="pag-gap">…</span>' : btn(x, x, '', x === p))).join('')
          + btn('Suivant' + arrowR, p + 1, 'pag-nav', false, p === pages);
      } else if (kind === 'cmp') {
        n.innerHTML = btn(arrowL, p - 1, 'pag-nav', false, p === 1)
          + `<span>Page</span><input type="number" min="1" max="${pages}" value="${p}" data-jump aria-label="Numéro de page"><span>sur <strong>${pages}</strong></span>`
          + btn(arrowR, p + 1, 'pag-nav', false, p === pages);
      } else {
        n.innerHTML = btn(arrowL, p - 1, 'pag-arrow', false, p === 1)
          + seq(p, pages).map((x) => (x === '…' ? '<span class="pag-gap">…</span>' : btn(x, x, '', x === p))).join('')
          + btn(arrowR, p + 1, 'pag-arrow', false, p === pages);
      }
    };

    const render = (scroll) => {
      const r = filtered();
      const pages = Math.max(1, Math.ceil(r.length / st.per));
      st.page = Math.min(Math.max(1, st.page), pages);
      const from = (st.page - 1) * st.per;
      const shown = r.slice(from, from + st.per);
      items.forEach((el) => { el.hidden = true; el.classList.remove('is-enter'); });
      r.forEach((el) => list.appendChild(el));
      shown.forEach((el, i) => { el.hidden = false; el.style.setProperty('--i', i); void el.offsetWidth; el.classList.add('is-enter'); });
      root.querySelectorAll('[data-range]').forEach((n) => (n.textContent = r.length ? `${from + 1}–${from + shown.length} sur ${r.length} produit${r.length > 1 ? 's' : ''}` : '0 produit'));
      root.querySelector('[data-empty]').hidden = r.length > 0;
      root.querySelectorAll('[data-pages]').forEach((n) => { n.hidden = r.length === 0; renderPages(n, pages); });
      const bar = root.querySelector('[data-prog]');
      if (bar) {
        const seen = from + shown.length;
        bar.style.width = r.length ? (seen / r.length) * 100 + '%' : '0';
        root.querySelector('[data-prog-t]').textContent = `${seen} sur ${r.length} produits parcourus`;
      }
      // États des filtres
      root.querySelectorAll('[data-g]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.g === st.g)));
      root.querySelectorAll('[data-c]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.c === st.c && b.dataset.cg === st.g)));
      root.querySelectorAll('[data-cats-of]').forEach((u) => u.classList.toggle('is-open', u.dataset.catsOf === st.g));
      root.querySelectorAll('.pc-cat').forEach((b) => (b.hidden = !st.g || b.dataset.cg !== st.g));
      if (scroll) {
        const top = root.querySelector('[data-top]').getBoundingClientRect().top + scrollY - 60;
        if (scrollY > top + 10) scrollTo({ top, behavior: 'smooth' });
      }
    };

    root.addEventListener('click', (e) => {
      const t = e.target.closest('button');
      if (!t || !root.contains(t)) return;
      if (t.dataset.go) { st.page = +t.dataset.go; render(true); return; }
      if (t.hasAttribute('data-c')) { st.g = t.dataset.cg; st.c = st.c === t.dataset.c ? '' : t.dataset.c; st.page = 1; render(false); return; }
      if (t.hasAttribute('data-g')) { st.g = t.dataset.g; st.c = ''; st.page = 1; render(false); return; }
      if (t.hasAttribute('data-reset')) { st.g = st.c = st.q = ''; st.page = 1; root.querySelectorAll('[data-q]').forEach((i) => (i.value = '')); render(false); return; }
      if (t.dataset.pop) { const i = root.querySelector('[data-q]'); i.value = t.dataset.pop; st.q = norm(t.dataset.pop); st.page = 1; render(false); return; }
      if (t.dataset.view) {
        root.classList.toggle('is-grid', t.dataset.view === 'grid');
        root.querySelectorAll('[data-view]').forEach((b) => b.setAttribute('aria-pressed', String(b === t)));
      }
    });
    root.addEventListener('input', (e) => {
      if (e.target.matches('[data-q]')) { st.q = norm(e.target.value.trim()); st.page = 1; render(false); }
    });
    root.addEventListener('change', (e) => {
      const t = e.target;
      if (t.matches('[data-sort]')) { st.sort = t.value; st.page = 1; render(false); }
      if (t.matches('[data-per]')) { st.per = +t.value; st.page = 1; root.querySelectorAll('[data-per]').forEach((s) => (s.value = t.value)); render(false); }
      if (t.matches('[data-jump]')) { st.page = +t.value || 1; render(true); }
    });
    render(false);
  });

  // Commutateur des visuels (étiquettes générées / illustrations actuelles)
  document.querySelectorAll('[data-vis-set]').forEach((b) => b.addEventListener('click', () => {
    document.body.dataset.vis = b.dataset.visSet;
    document.querySelectorAll('[data-vis-set]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  }));
})();
</script>
</body>
</html>
