---
// PLANCHE DE TRAVAIL (non destinée à la mise en ligne) : 3 propositions pour la page Catalogue (/produits/).
// Vrais produits (src/data/catalog.ts), filtres, recherche, tri et pagination fonctionnels.
// À déplacer dans src/pages/_planches/ (exclu du build) avant toute mise en ligne.
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-800.css';
import '@fontsource/carlito/latin-400.css';
import '@fontsource/carlito/latin-700.css';
import '../../styles/global.css';
import { Picture } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import { catalog, type Group } from '../../data/catalog';
import { productFamilies } from '../../data/products';
import { useCatalog, routeLabel, formatLabel } from '../../i18n/catalog';
import { packshot } from '../../components/produits/packshot';

const c = useCatalog('fr');
const order: Group[] = productFamilies.map((f) => f.group);
const famIcon = Object.fromEntries(productFamilies.map((f) => [f.group, f.icon]));
const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

const items = order.flatMap((g) => catalog.filter((x) => x.group === g)).map((x, i) => {
  const made = x.family === 'iv' || x.family === 'liquids';
  const formats = (x.formats ?? []).map((f) => formatLabel('fr', f));
  const packLabel = x.pack ? c.packs[x.pack] : '';
  const route = x.route ? routeLabel('fr', x.route) : '';
  return {
    i, id: x.id, g: x.group, cat: x.cat, kind: x.family, made,
    name: x.name.fr, use: x.use.fr, formats, route, packLabel,
    line: x.line ? c.lines[x.line] : '',
    catLabel: c.cats[x.cat] ?? x.cat, groupLabel: c.groups[x.group].label,
    badge: c.status[x.family].badge,
    illu: `/media/categories/${x.cat}.svg`,
    pk: packshot({ group: x.group, cat: x.cat, name: x.name.fr, formats, route, line: x.line, pack: x.pack, made, packLabel }),
    s: norm([x.name.fr, x.name.en, x.use.fr, x.keywords, c.cats[x.cat], c.groups[x.group].label].join(' ')),
  };
});
type Item = (typeof items)[number];
const byGroup = (g: Group) => items.filter((x) => x.g === g);
const catsOf = (g: Group) => [...new Set(byGroup(g).map((x) => x.cat))].map((k) => ({ k, label: c.cats[k] ?? k, n: items.filter((x) => x.cat === k && x.g === g).length }));
const nCats = new Set(items.map((x) => x.g + x.cat)).size;
const statusCls = (k: string) => `st st--${k}`;
const popular = ['Paracétamol', 'Ceftriaxone', 'Glucose', 'Ringer', 'Vitamine', 'Pince'];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Planche · Page Catalogue · 3 propositions</title>
</head>
<body data-vis="pack">

<header class="pl-bar">
  <div class="pl-bar__in">
    <p class="pl-bar__t"><strong>Planche · Page Catalogue</strong> <span>3 propositions · 120 vrais produits · filtres et pagination fonctionnels</span></p>
    <nav class="pl-bar__nav" aria-label="Propositions">
      <a href="#prop-a">A · Vitrine</a><a href="#prop-b">B · Référentiel</a><a href="#prop-c">C · Galerie</a>
    </nav>
    <div class="pl-bar__vis" role="group" aria-label="Visuels des produits">
      <span>Visuels :</span>
      <button type="button" data-vis-set="pack" aria-pressed="true">Étiquettes produit</button>
      <button type="button" data-vis-set="illu" aria-pressed="false">Illustrations actuelles</button>
    </div>
  </div>
</header>

<!-- ======================================================================= -->
<!-- A · VITRINE                                                              -->
<!-- ======================================================================= -->
<section class="pl-intro" id="prop-a">
  <div class="wrap">
    <p class="pl-intro__k">Proposition A <em>Recommandée</em></p>
    <h2>Vitrine · filtres latéraux et grille de cartes</h2>
    <div class="pl-intro__cols">
      <p>Le modèle des grands laboratoires : un en-tête court avec les chiffres clés, puis tout de suite le catalogue. À gauche, une colonne fixe avec la recherche, les 5 gammes et leurs catégories (elles se déplient quand on choisit une gamme). À droite, une grille de 3 colonnes de cartes aérées : visuel, gamme, nom, usage, présentations, statut.</p>
      <ul>
        <li><strong>Pagination :</strong> numérotée classique (Précédent · 1 2 3 … 10 · Suivant), 12 produits par page, réglable à 24 ou 48, compteur « 1–12 sur 120 ».</li>
        <li><strong>Tri :</strong> ordre du catalogue ou alphabétique.</li>
        <li><strong>Mobile :</strong> la colonne de filtres devient un bouton « Filtres » ; la grille passe à 2 puis 1 colonne.</li>
        <li><strong>Remplace</strong> le bloc « Cinq gammes » actuel (les gammes sont dans la colonne de gauche).</li>
      </ul>
    </div>
  </div>
</section>

<div class="pa" data-demo data-per="12">
  <div class="pa-hero">
    <div class="wrap pa-hero__in">
      <div>
        <p class="pa-crumb">Accueil <span>/</span> Produits <span>/</span> Catalogue</p>
        <h1>Catalogue</h1>
        <p class="pa-hero__lead">Solutés injectables, médicaments, nutrition, dispositifs médicaux et produits vétérinaires : toutes nos références, avec leur fiche technique.</p>
      </div>
      <dl class="pa-hero__kpi">
        <div><dt>références</dt><dd>{items.length}</dd></div>
        <div><dt>gammes</dt><dd>5</dd></div>
        <div><dt>catégories</dt><dd>{nCats}</dd></div>
      </dl>
    </div>
  </div>

  <div class="wrap pa-layout" data-top>
    <aside class="pa-side">
      <label class="pa-search"><Icon name="search" size={18} /><input type="search" placeholder="Nom, usage, catégorie…" data-q /></label>
      <p class="pa-side__h">Gammes</p>
      <ul class="pa-side__list">
        <li><button type="button" class="pa-g" data-g="" aria-pressed="true"><span class="pa-g__ic"><Icon name="layers" size={16} /></span>Toutes les gammes<span class="pa-g__n">{items.length}</span></button></li>
        {order.map((g) => (
          <li>
            <button type="button" class="pa-g" data-g={g} aria-pressed="false"><span class="pa-g__ic"><Icon name={famIcon[g]} size={16} /></span>{c.groups[g].label}<span class="pa-g__n">{byGroup(g).length}</span></button>
            <ul class="pa-side__cats" data-cats-of={g}>
              {catsOf(g).map((k) => <li><button type="button" class="pa-c" data-c={k.k} data-cg={g} aria-pressed="false">{k.label}<span>{k.n}</span></button></li>)}
            </ul>
          </li>
        ))}
      </ul>
      <div class="pa-side__help">
        <p><strong>Besoin d'une cotation ?</strong> Notre équipe répond aux centrales d'achat et aux distributeurs.</p>
        <a href="#" class="btn btn--sm">Demander la documentation</a>
      </div>
    </aside>

    <div class="pa-main">
      <div class="pa-tool">
        <p class="pa-tool__r" data-range></p>
        <div class="pa-tool__opts">
          <label>Trier <select data-sort><option value="">Catalogue</option><option value="az">Nom A → Z</option><option value="za">Nom Z → A</option></select></label>
          <label>Afficher <select data-per><option>12</option><option>24</option><option>48</option></select></label>
        </div>
      </div>
      <ul class="pa-grid" data-list>
        {items.map((x: Item) => (
          <li class="pa-card" data-item data-g={x.g} data-c={x.cat} data-s={x.s} data-n={x.name}>
            <a href="#" class="pa-card__in" onclick="return false">
              <span class="pa-card__vis vis">{x.pk && <span class="v-pack" set:html={x.pk} />}<img class={x.pk ? 'v-illu' : ''} src={x.illu} alt="" loading="lazy" /></span>
              <span class="pa-card__body">
                <span class="pa-card__k">{x.groupLabel} · {x.catLabel}</span>
                <span class="pa-card__name">{x.name}</span>
                <span class="pa-card__use">{x.use}</span>
                {x.formats.length > 0 && <span class="pa-card__f">{x.formats.map((f) => <span dir="ltr">{f}</span>)}</span>}
                <span class="pa-card__foot"><span class={statusCls(x.kind)}>{x.badge}</span><span class="pa-card__go">Voir la fiche<Icon name="arrow" size={15} /></span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="empty" data-empty hidden><p>Aucun produit ne correspond à votre recherche.</p><button type="button" class="btn btn--ghost btn--sm" data-reset>Effacer les filtres</button></div>
      <nav class="pa-pag" aria-label="Pagination"><p data-range></p><div class="pag-num" data-pages="num"></div></nav>
    </div>
  </div>
</div>

<!-- ======================================================================= -->
<!-- B · RÉFÉRENTIEL                                                          -->
<!-- ======================================================================= -->
<section class="pl-intro" id="prop-b">
  <div class="wrap">
    <p class="pl-intro__k">Proposition B</p>
    <h2>Référentiel · liste professionnelle, recherche en vedette</h2>
    <div class="pl-intro__cols">
      <p>Pensée pour les acheteurs (centrales d'achat, hôpitaux, distributeurs) qui viennent chercher une référence précise. Grande recherche dès l'en-tête avec recherches fréquentes, onglets des gammes, puis une liste en lignes, dense mais lisible : vignette, nom et usage, présentations, voie et conditionnement, statut, accès à la fiche. Un bouton permet de passer en grille.</p>
      <ul>
        <li><strong>Pagination :</strong> compacte « Page 2 sur 8 » avec saisie directe du numéro, flèches et choix 15 / 30 / 60 lignes, répétée en haut et en bas de la liste.</li>
        <li><strong>Points forts :</strong> le plus d'informations à l'écran, comparaison facile entre produits.</li>
        <li><strong>Limite :</strong> moins « vitrine », les visuels sont petits.</li>
      </ul>
    </div>
  </div>
</section>

<div class="pb" data-demo data-per="15">
  <div class="pb-hero">
    <div class="wrap">
      <p class="pa-crumb pa-crumb--dark">Accueil <span>/</span> Produits <span>/</span> Catalogue</p>
      <div class="pb-hero__in">
        <div>
          <h1>Trouvez un produit</h1>
          <p class="pb-hero__lead">{items.length} références en 5 gammes, chacune avec sa fiche technique téléchargeable.</p>
        </div>
        <div class="pb-hero__s">
          <label class="pb-search"><Icon name="search" size={22} /><input type="search" placeholder="Rechercher un médicament, une solution ou un dispositif…" data-q /></label>
          <p class="pb-pop">Recherches fréquentes : {popular.map((w) => <button type="button" data-pop={w}>{w}</button>)}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="pb-tabs" data-top>
    <div class="wrap pb-tabs__in" role="group" aria-label="Gammes">
      <button type="button" class="pb-tab" data-g="" aria-pressed="true">Tout <span>{items.length}</span></button>
      {order.map((g) => <button type="button" class="pb-tab" data-g={g} aria-pressed="false">{c.groups[g].label} <span>{byGroup(g).length}</span></button>)}
    </div>
  </div>

  <div class="wrap pb-body">
    <div class="pb-tool">
      <p data-range></p>
      <div class="pb-tool__r">
        <div class="pb-view" role="group" aria-label="Affichage"><button type="button" data-view="list" aria-pressed="true" title="Liste"><Icon name="menu" size={18} /></button><button type="button" data-view="grid" aria-pressed="false" title="Grille"><Icon name="layers" size={18} /></button></div>
        <div class="pag-cmp" data-pages="cmp"></div>
      </div>
    </div>
    <div class="pb-head" aria-hidden="true"><span></span><span>Produit</span><span>Présentations</span><span>Voie · conditionnement</span><span>Statut</span><span></span></div>
    <ul class="pb-list" data-list>
      {items.map((x: Item) => (
        <li class="pb-row" data-item data-g={x.g} data-c={x.cat} data-s={x.s} data-n={x.name}>
          <span class="pb-row__vis vis">{x.pk && <span class="v-pack" set:html={x.pk} />}<img class={x.pk ? 'v-illu' : ''} src={x.illu} alt="" loading="lazy" /></span>
          <span class="pb-row__main"><span class="pb-row__k">{x.catLabel}</span><a href="#" onclick="return false" class="pb-row__name">{x.name}</a><span class="pb-row__use">{x.use}</span></span>
          <span class="pb-row__f">{x.formats.length ? x.formats.map((f) => <span dir="ltr">{f}</span>) : <em>Sur demande</em>}</span>
          <span class="pb-row__m">{x.route && <span>{x.route}</span>}{x.packLabel ? <span>{x.packLabel}</span> : <em>—</em>}</span>
          <span><span class={statusCls(x.kind)}>{x.badge}</span></span>
          <span class="pb-row__act"><a href="#" onclick="return false" class="pb-btn">Fiche<Icon name="arrow" size={14} /></a>{x.made && <a href="#" onclick="return false" class="pb-pdf" title="Fiche technique PDF"><Icon name="download" size={16} /></a>}</span>
        </li>
      ))}
    </ul>
    <div class="empty" data-empty hidden><p>Aucun produit ne correspond à votre recherche.</p><button type="button" class="btn btn--ghost btn--sm" data-reset>Effacer les filtres</button></div>
    <nav class="pb-pag" aria-label="Pagination">
      <p data-range></p>
      <label>Lignes par page <select data-per><option>15</option><option>30</option><option>60</option></select></label>
      <div class="pag-cmp" data-pages="cmp"></div>
    </nav>
  </div>
</div>

<!-- ======================================================================= -->
<!-- C · GALERIE                                                              -->
<!-- ======================================================================= -->
<section class="pl-intro" id="prop-c">
  <div class="wrap">
    <p class="pl-intro__k">Proposition C</p>
    <h2>Galerie · les gammes en images, produits mis en scène</h2>
    <div class="pl-intro__cols">
      <p>La plus « marque » : l'en-tête présente les 5 gammes en grandes vignettes photo qui servent elles-mêmes de filtres. En dessous, une galerie de 4 colonnes où le visuel domine, comme un packshot de laboratoire ; au survol, un panneau monte avec l'usage, les présentations et le lien vers la fiche.</p>
      <ul>
        <li><strong>Pagination :</strong> pastilles numérotées centrées avec grandes flèches rondes et une barre de progression « 16 sur 120 produits parcourus ».</li>
        <li><strong>Points forts :</strong> rendu le plus premium, très visuel, idéal en salon ou en présentation.</li>
        <li><strong>Limite :</strong> moins d'informations visibles sans survol (sur mobile le panneau est toujours affiché).</li>
      </ul>
    </div>
  </div>
</section>

<div class="pc" data-demo data-per="16">
  <div class="pc-hero">
    <div class="wrap">
      <p class="pa-crumb">Accueil <span>/</span> Produits <span>/</span> Catalogue</p>
      <div class="pc-hero__in">
        <h1>Nos produits</h1>
        <p>Cinq gammes, {items.length} références. Choisissez une gamme ou parcourez tout le catalogue.</p>
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="pc-tiles" role="group" aria-label="Gammes">
      <button type="button" class="pc-tile pc-tile--all" data-g="" aria-pressed="true"><span class="pc-tile__t">Toutes les gammes</span><span class="pc-tile__n">{items.length} références</span></button>
      {productFamilies.map((f) => (
        <button type="button" class="pc-tile" data-g={f.group} aria-pressed="false">
          <Picture src={f.card} formats={['avif', 'webp']} widths={[360, 560]} sizes="20vw" alt="" loading="lazy" />
          <span class="pc-tile__t">{c.groups[f.group].label}</span>
          <span class="pc-tile__n">{byGroup(f.group).length} références</span>
        </button>
      ))}
    </div>

    <div class="pc-tool" data-top>
      <label class="pc-search"><Icon name="search" size={18} /><input type="search" placeholder="Rechercher…" data-q /></label>
      <div class="pc-cats" data-pc-cats>
        {order.map((g) => catsOf(g).map((k) => <button type="button" class="pc-cat" data-c={k.k} data-cg={g} aria-pressed="false" hidden>{k.label}</button>))}
      </div>
      <p class="pc-tool__r" data-range></p>
    </div>

    <ul class="pc-grid" data-list>
      {items.map((x: Item) => (
        <li class="pc-card" data-item data-g={x.g} data-c={x.cat} data-s={x.s} data-n={x.name}>
          <a href="#" onclick="return false" class="pc-card__in">
            <span class="pc-card__vis vis">{x.pk && <span class="v-pack" set:html={x.pk} />}<img class={x.pk ? 'v-illu' : ''} src={x.illu} alt="" loading="lazy" /><span class={statusCls(x.kind) + ' pc-card__st'}>{x.badge}</span>
              <span class="pc-card__over">
                <span class="pc-card__use">{x.use}</span>
                {x.formats.length > 0 && <span class="pa-card__f">{x.formats.map((f) => <span dir="ltr">{f}</span>)}</span>}
                <span class="pc-card__go">Voir la fiche<Icon name="arrow" size={15} /></span>
              </span></span>
            <span class="pc-card__name">{x.name}</span>
            <span class="pc-card__k">{x.catLabel}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="empty" data-empty hidden><p>Aucun produit ne correspond à votre recherche.</p><button type="button" class="btn btn--ghost btn--sm" data-reset>Effacer les filtres</button></div>
    <nav class="pc-pag" aria-label="Pagination">
      <div class="pag-dot" data-pages="dot"></div>
      <div class="pc-prog"><span class="pc-prog__bar"><span data-prog></span></span><span data-prog-t></span></div>
    </nav>
  </div>
</div>

<footer class="pl-end"><div class="wrap">Fin de la planche · les liens « Voir la fiche » sont désactivés ici.</div></footer>

<style is:global>
  body { background: #fff; }
  [data-vis='pack'] .v-illu, [data-vis='illu'] .v-pack { display: none !important; }
  .vis { position: relative; display: block; overflow: hidden; }
  .vis img, .vis .v-pack, .vis .pk { display: block; width: 100%; height: 100%; }
  .vis img { object-fit: cover; }
  .pk text { font-family: var(--font-head); }
  .btn--sm { height: 40px; padding: 0 16px; font-size: .8125rem; }

  /* Barre de planche */
  .pl-bar { position: sticky; top: 0; z-index: 50; background: var(--navy-900); color: #cfe0f5; font-family: var(--font-head); font-size: .8125rem; }
  .pl-bar__in { display: flex; align-items: center; gap: 24px; max-width: 1440px; margin: 0 auto; padding: 10px 24px; flex-wrap: wrap; }
  .pl-bar__t strong { color: #fff; } .pl-bar__t span { opacity: .7; margin-left: 8px; }
  .pl-bar__nav { display: flex; gap: 6px; margin-left: auto; }
  .pl-bar__nav a { padding: 6px 12px; border-radius: 99px; background: rgba(255,255,255,.08); color: #fff; font-weight: 700; }
  .pl-bar__nav a:hover { background: var(--blue); }
  .pl-bar__vis { display: flex; align-items: center; gap: 6px; }
  .pl-bar__vis button { padding: 6px 12px; border-radius: 99px; border: 1px solid rgba(255,255,255,.2); color: #fff; font-weight: 700; font-size: .75rem; }
  .pl-bar__vis button[aria-pressed='true'] { background: var(--green); border-color: var(--green); }

  .pl-intro { padding: 72px 0 40px; background: #fffbea; border-top: 6px solid var(--navy); scroll-margin-top: 40px; }
  .pl-intro__k { font-family: var(--font-head); font-weight: 800; font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--blue); }
  .pl-intro__k em { margin-left: 8px; padding: 3px 9px; border-radius: 99px; background: var(--green); color: #fff; font-style: normal; letter-spacing: .04em; }
  .pl-intro h2 { margin-top: 8px; font-size: 1.9rem; color: var(--navy); }
  .pl-intro__cols { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; margin-top: 18px; font-size: 1.02rem; line-height: 1.55; }
  .pl-intro__cols li { margin-bottom: 6px; padding-left: 14px; position: relative; }
  .pl-intro__cols li::before { content: ''; position: absolute; left: 0; top: .6em; width: 6px; height: 6px; border-radius: 50%; background: var(--green); }
  .pl-end { padding: 40px 0; background: var(--navy-900); color: #cfe0f5; font-family: var(--font-head); font-size: .875rem; }

  /* Statuts communs */
  .st { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-head); font-weight: 700; font-size: .6875rem; letter-spacing: .02em; color: var(--muted); white-space: nowrap; }
  .st::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #c58a1d; box-shadow: 0 0 0 3px #fbf1dc; }
  .st--devices::before { background: var(--green); box-shadow: 0 0 0 3px var(--green-50); }
  .st--vet::before { background: var(--blue); box-shadow: 0 0 0 3px var(--blue-50); }
  .empty { padding: 48px; text-align: center; border: 1px dashed var(--line); border-radius: var(--radius-lg); font-family: var(--font-head); color: var(--navy); }
  .empty .btn { margin-top: 14px; }
  [data-item].is-enter { animation: itemIn .55s var(--ease) both; animation-delay: calc(var(--i, 0) * 35ms); }
  @keyframes itemIn { from { opacity: 0; transform: translateY(14px); } }

  /* ---------- A ---------- */
  .pa { background: var(--mist); padding-bottom: 96px; }
  .pa-hero { position: relative; background: var(--navy-900); color: #fff; padding: 44px 0 48px; }
  .pa-hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 5px; background: linear-gradient(90deg, var(--blue) 70%, var(--green) 70%); }
  .pa-hero__in { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; }
  .pa-crumb { font-family: var(--font-head); font-size: .75rem; font-weight: 600; color: #9fb6d6; }
  .pa-crumb span { margin: 0 6px; opacity: .6; }
  .pa-crumb--dark { color: var(--muted); }
  .pa-hero h1 { margin-top: 14px; font-size: clamp(2.2rem, 1.6rem + 2vw, 3.2rem); color: #fff; }
  .pa-hero__lead { max-width: 640px; margin-top: 10px; font-size: 1.1rem; color: #cfe0f5; }
  .pa-hero__kpi { display: flex; gap: 0; }
  .pa-hero__kpi div { display: flex; flex-direction: column-reverse; padding: 0 28px; border-left: 1px solid rgba(255,255,255,.15); }
  .pa-hero__kpi dd { margin: 0; font-family: var(--font-head); font-weight: 800; font-size: 2.6rem; line-height: 1; color: #fff; }
