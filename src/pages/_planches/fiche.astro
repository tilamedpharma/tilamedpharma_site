---
// PLANCHE DE TRAVAIL (non destinée à la mise en ligne) : 3 propositions pour la page « fiche produit » (/produits/{slug}/).
// 3 produits types × 2 états (fiche actuelle sans textes / fiche remplie avec textes d'EXEMPLE).
// À déplacer dans src/pages/_planches/ (exclu du build) avant toute mise en ligne.
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-800.css';
import '@fontsource/carlito/latin-400.css';
import '@fontsource/carlito/latin-700.css';
import '../../styles/global.css';
import '../../styles/pages.css';
import Icon from '../../components/Icon.astro';
import { catalog } from '../../data/catalog';
import { useCatalog, routeLabel, formatLabel } from '../../i18n/catalog';
import { packshot } from '../../components/produits/packshot';

const c = useCatalog('fr');
const f = c.fiche;
const vis = (x: (typeof catalog)[number]) => {
  const formats = (x.formats ?? []).map((s) => formatLabel('fr', s));
  const made = x.family === 'iv' || x.family === 'liquids';
  return packshot({ group: x.group, cat: x.cat, name: x.name.fr, formats, route: x.route ? routeLabel('fr', x.route) : '', line: x.line, pack: x.pack, made, packLabel: x.pack ? c.packs[x.pack] : '' });
};
const illu = (cat: string) => `/media/categories/${cat}.svg`;

// Textes d'EXEMPLE (planche uniquement) : ce que le client pourra saisir dans le back office.
const samples: Record<string, { k: keyof typeof f.fields; v: string }[]> = {
  haloperidol: [
    { k: 'composition', v: 'Halopéridol 5 mg\nAcide lactique, eau pour préparations injectables q.s.p. 1 ml' },
    { k: 'form', v: 'Solution injectable limpide, en ampoule de verre de 1 ml.' },
    { k: 'indications', v: 'Agitation et agressivité au cours des états psychotiques aigus.' },
    { k: 'dosage', v: 'Voie intramusculaire. Posologie établie par le médecin selon l’état du patient.' },
    { k: 'contraindications', v: '- Hypersensibilité à l’halopéridol\n- États comateux\n- Maladie de Parkinson' },
    { k: 'storage', v: 'À conserver à une température ne dépassant pas 25 °C, dans l’emballage d’origine, à l’abri de la lumière.' },
    { k: 'shelfLife', v: '3 ans.' },
  ],
  'vet-croquettes-chiot': [
    { k: 'composition', v: 'Viandes et sous-produits animaux (dont poulet 26 %), céréales, huiles et graisses, minéraux, vitamines.' },
    { k: 'indications', v: 'Aliment complet pour chiots de 2 à 12 mois.' },
    { k: 'dosage', v: 'Ration journalière selon le poids adulte attendu ; eau fraîche à volonté.' },
    { k: 'storage', v: 'Conserver le sac refermé, dans un endroit frais et sec.' },
  ],
  stethoscope: [
    { k: 'specs', v: '- Double pavillon en acier inoxydable\n- Membrane double fréquence\n- Tubulure en Y sans latex\n- Embouts auriculaires souples' },
    { k: 'regulatory', v: 'Dispositif médical de classe I, marquage CE.' },
  ],
};
const docs = [{ t: 'Notice', d: 'PDF · 240 Ko · Français' }, { t: 'Certificat d’analyse', d: 'PDF · 180 Ko · Toutes langues' }];

const ids = ['haloperidol', 'vet-croquettes-chiot', 'stethoscope'];
const products = ids.map((id) => {
  const x = catalog.find((p) => p.id === id)!;
  const formats = (x.formats ?? []).map((s) => formatLabel('fr', s));
  const made = x.family === 'iv' || x.family === 'liquids';
  const sameCat = catalog.filter((p) => p.cat === x.cat && p.group === x.group);
  const i = sameCat.findIndex((p) => p.id === id);
  const st = c.status[x.family];
  const speciesTxt = x.species ? f.speciesList[x.species as keyof typeof f.speciesList] : '';
  const facts = [
    { icon: 'vial', l: c.ui.formats, v: formats.join(' · ') || 'Sur demande' },
    x.route ? { icon: 'route', l: c.ui.route, v: routeLabel('fr', x.route) } : speciesTxt ? { icon: 'paw', l: f.species, v: speciesTxt } : { icon: 'tag', l: f.category, v: c.cats[x.cat] },
    { icon: 'box', l: c.ui.pack, v: x.pack ? c.packs[x.pack] : 'Sur demande' },
    made ? { icon: 'factory', l: c.ui.line, v: c.lines[x.line ?? ''] ?? '' } : { icon: 'truck', l: 'Origine', v: 'Distribué par TILAMED' },
  ];
  const specs: [string, string][] = [
    [f.range, c.groups[x.group].label], [f.category, c.cats[x.cat]], [f.status, st.note],
    ...(formats.length ? [[c.ui.formats, formats.join(' · ')] as [string, string]] : []),
    ...(x.route ? [[c.ui.route, routeLabel('fr', x.route)] as [string, string]] : []),
    ...(x.line ? [[c.ui.line, c.lines[x.line]] as [string, string]] : []),
    ...(x.pack ? [[c.ui.pack, c.packs[x.pack]] as [string, string]] : []),
    ...(x.phase ? [[f.phase, c.phases[x.phase]] as [string, string]] : []),
    ...(speciesTxt ? [[f.species, speciesTxt] as [string, string]] : []),
  ];
  return {
    id, x, made, formats, st, facts, specs,
    name: x.name.fr, use: x.use.fr, group: c.groups[x.group].label, cat: c.cats[x.cat],
    pk: vis(x), illu: illu(x.cat),
    texts: (samples[id] ?? []).map((s) => ({ ...s, label: f.fields[s.k] })),
    related: sameCat.filter((p) => p.id !== id).slice(0, 8).map((p) => ({ name: p.name.fr, f: (p.formats ?? []).map((s) => formatLabel('fr', s)).join(' · '), pk: vis(p), illu: illu(p.cat), badge: c.status[p.family].badge, kind: p.family })),
    prev: i > 0 ? sameCat[i - 1].name.fr : '', next: i < sameCat.length - 1 ? sameCat[i + 1].name.fr : '',
    pos: `${i + 1} / ${sameCat.length}`,
  };
});
type P = (typeof products)[number];
const rich = (s: string) => {
  const lines = s.split('\n').filter(Boolean);
  return lines.every((l) => l.startsWith('- ')) ? `<ul>${lines.map((l) => `<li>${l.slice(2)}</li>`).join('')}</ul>` : lines.map((l) => `<p>${l}</p>`).join('');
};
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Planche · Fiche produit · 3 propositions</title>
</head>
<body data-p="haloperidol" class="">

<header class="pl-bar">
  <div class="pl-bar__in">
    <p class="pl-bar__t"><strong>Planche · Fiche produit</strong></p>
    <nav class="pl-bar__nav"><a href="#prop-a">A · Laboratoire</a><a href="#prop-b">B · Dossier</a><a href="#prop-c">C · Vitrine</a></nav>
    <div class="pl-bar__grp" role="group" aria-label="Produit">
      <span>Produit :</span>
      {products.map((p, i) => <button type="button" data-set-p={p.id} aria-pressed={String(i === 0)}>{p.name.replace(' (comprimés)', '')}</button>)}
    </div>
    <div class="pl-bar__grp" role="group" aria-label="État">
      <span>Fiche :</span>
      <button type="button" data-set-full="0" aria-pressed="true">Actuelle (sans textes)</button>
      <button type="button" data-set-full="1" aria-pressed="false">Remplie (exemple)</button>
    </div>
  </div>
</header>

<!-- ====================================================================== A -->
<section class="pl-intro" id="prop-a">
  <div class="wrap">
    <p class="pl-intro__k">Proposition A <em>Recommandée</em></p>
    <h2>Laboratoire · grand visuel, « En bref », onglets</h2>
    <div class="pl-intro__cols">
      <p>Le modèle des fiches des grands laboratoires et des sites e-commerce haut de gamme. En-tête clair : grand visuel à gauche, à droite le nom, l'usage, le statut, 4 informations clés en pictogrammes et les deux actions (fiche PDF, cotation). Une barre d'onglets fixe mène aux rubriques. Elle ne montre que celles qui sont remplies, donc pas de rubriques vides aujourd'hui.</p>
      <ul>
        <li><strong>Sans textes :</strong> un encadré « Dossier technique complet sur demande » remplace les rubriques vides.</li>
        <li><strong>Navigation :</strong> produit précédent / suivant de la même catégorie, en haut à droite.</li>
        <li><strong>Produits similaires :</strong> rail compact qui défile (cartes plus petites).</li>
        <li><strong>Supprime</strong> les doublons actuels (bouton PDF en double, statut et catégorie répétés).</li>
      </ul>
    </div>
  </div>
</section>
{products.map((p: P) => (
  <div class="fa" data-prod={p.id}>
    <div class="fa-top">
      <div class="wrap fa-top__in">
        <p class="crumbs-pl">Accueil <span>/</span> Catalogue <span>/</span> {p.group} <span>/</span> <b>{p.name}</b></p>
        <p class="fa-pn">
          {p.prev && <a href="#" onclick="return false"><Icon name="arrow" size={14} class="fa-back" />Précédent</a>}
          <span>{p.pos} · {p.cat}</span>
          {p.next && <a href="#" onclick="return false">Suivant<Icon name="arrow" size={14} /></a>}
        </p>
      </div>
    </div>
    <div class="fa-hero">
      <div class="wrap fa-hero__in">
        <div class="fa-stage">
          {p.pk ? <span class="fa-stage__v" set:html={p.pk} /> : <img class="fa-stage__i" src={p.illu} alt="" />}
          <span class={`pcard__st pcard__st--${p.x.family}`}>{p.st.badge}</span>
        </div>
        <div class="fa-info">
          <p class="fa-eyebrow"><a href="#" onclick="return false">{p.group}</a> · <a href="#" onclick="return false">{p.cat}</a></p>
          <h1 class="fa-title">{p.name}</h1>
          <p class="fa-lead">{p.use}</p>
          <p class="fa-note"><span class={`fa-dot fa-dot--${p.x.family}`}></span>{p.st.note}</p>
          <ul class="fa-facts">
            {p.facts.map((k) => <li><span class="fa-facts__ic"><Icon name={k.icon} size={20} /></span><span><small>{k.l}</small><b>{k.v}</b></span></li>)}
          </ul>
          <div class="fa-ctas">
            <a class="btn" href="#" onclick="return false"><Icon name="download" size={18} />{f.download}<small class="fa-pdf">PDF</small></a>
            <a class="btn btn--ghost" href="#" onclick="return false">Demander une cotation</a>
          </div>
          <p class="fa-pro"><Icon name="shield" size={16} />Information destinée aux professionnels de santé</p>
        </div>
      </div>
    </div>
    <nav class="fa-tabs" aria-label="Rubriques">
      <div class="wrap fa-tabs__in">
        <a href="#" class="is-on" onclick="return false">{f.characteristics}</a>
        {p.texts.map((t) => <a href="#" onclick="return false" data-full-only>{t.label}</a>)}
        <a href="#" onclick="return false" data-full-only>Documents <span>2</span></a>
        <a href="#" onclick="return false" class="fa-tabs__pdf"><Icon name="download" size={16} />PDF</a>
      </div>
    </nav>
    <div class="fa-body">
      <div class="wrap">
        <h2 class="fa-h">{f.characteristics}</h2>
        <dl class="fa-spec">{p.specs.map(([l, v]) => <div><dt>{l}</dt><dd>{v}</dd></div>)}</dl>
        <div data-full-only>
          <div class="fa-texts">
            {p.texts.map((t) => <section class="fa-text"><h3>{t.label}</h3><div set:html={rich(t.v)} /></section>)}
          </div>
          <h2 class="fa-h">Documents à télécharger</h2>
          <ul class="fa-docs">{docs.map((d) => <li><a href="#" onclick="return false"><span class="fa-docs__ic"><Icon name="download" size={20} /></span><span><b>{d.t}</b><small>{d.d}</small></span><Icon name="arrow" size={16} /></a></li>)}</ul>
        </div>
        <div class="fa-req" data-empty-only>
          <span class="fa-req__ic"><Icon name="book" size={26} /></span>
          <div><p class="fa-req__t">{f.onRequestTitle}</p><p>{f.onRequest}</p></div>
          <a class="btn" href="#" onclick="return false">Demander le dossier</a>
        </div>
        <p class="fa-disc">{f.disclaimer}</p>
      </div>
    </div>
    <div class="fa-rel">
      <div class="wrap">
        <div class="fa-rel__h"><h2 class="fa-h">{f.related}</h2><a href="#" class="link-arrow" onclick="return false">{f.backRange}<Icon name="arrow" size={16} /></a></div>
        <ul class="fa-rail">
          {p.related.map((r) => <li><a href="#" onclick="return false"><span class="fa-rail__v">{r.pk ? <Fragment set:html={r.pk} /> : <img src={r.illu} alt="" />}</span><b>{r.name}</b><small>{r.f || r.badge}</small></a></li>)}
        </ul>
      </div>
    </div>
  </div>
))}

<!-- ====================================================================== B -->
<section class="pl-intro" id="prop-b">
  <div class="wrap">
    <p class="pl-intro__k">Proposition B</p>
    <h2>Dossier · rubriques numérotées comme la fiche PDF, carte produit fixe</h2>
    <div class="pl-intro__cols">
      <p>Pensée comme un dossier technique en ligne, cohérente avec la fiche PDF qui a déjà des rubriques numérotées. L'en-tête bleu nuit reste court, comme sur le reste du site. À gauche, les rubriques numérotées 01, 02, 03… avec un sommaire en pastilles. À droite, une carte produit qui reste visible au défilement : visuel, statut, informations clés, bouton PDF et cotation.</p>
      <ul>
        <li><strong>Points forts :</strong> très lisible pour les acheteurs et les pharmaciens, l'action (PDF / cotation) est toujours à portée.</li>
        <li><strong>Produits similaires :</strong> liste compacte en 2 colonnes (vignette, nom, présentation).</li>
        <li><strong>Limite :</strong> visuel plus petit, rendu moins « vitrine ».</li>
      </ul>
    </div>
  </div>
</section>
{products.map((p: P) => (
  <div class="fb" data-prod={p.id}>
    <div class="fb-hero">
      <div class="wrap">
        <p class="crumbs-pl crumbs-pl--light">Accueil <span>/</span> Catalogue <span>/</span> {p.group} <span>/</span> <b>{p.name}</b></p>
        <p class="fb-eyebrow">{f.eyebrow} · {p.group}</p>
        <h1 class="fb-title">{p.name}</h1>
        <p class="fb-lead">{p.use}</p>
      </div>
    </div>
    <div class="wrap fb-grid">
      <div class="fb-main">
        <ol class="fb-toc">
          <li><a href="#" onclick="return false"><span>01</span>{f.characteristics}</a></li>
          {p.texts.map((t, i) => <li data-full-only><a href="#" onclick="return false"><span>{String(i + 2).padStart(2, '0')}</span>{t.label}</a></li>)}
          <li data-full-only><a href="#" onclick="return false"><span>{String(p.texts.length + 2).padStart(2, '0')}</span>Documents</a></li>
        </ol>
        <section class="fb-sec">
          <h2><span>01</span>{f.characteristics}</h2>
          <dl class="fb-spec">{p.specs.map(([l, v]) => <div><dt>{l}</dt><dd>{v}</dd></div>)}</dl>
        </section>
        {p.texts.map((t, i) => <section class="fb-sec" data-full-only><h2><span>{String(i + 2).padStart(2, '0')}</span>{t.label}</h2><div class="fb-txt" set:html={rich(t.v)} /></section>)}
        <section class="fb-sec" data-full-only>
          <h2><span>{String(p.texts.length + 2).padStart(2, '0')}</span>Documents à télécharger</h2>
          <ul class="fa-docs fa-docs--1">{docs.map((d) => <li><a href="#" onclick="return false"><span class="fa-docs__ic"><Icon name="download" size={20} /></span><span><b>{d.t}</b><small>{d.d}</small></span><Icon name="arrow" size={16} /></a></li>)}</ul>
        </section>
        <section class="fb-sec fb-req" data-empty-only>
          <h2><span>02</span>{f.onRequestTitle}</h2>
          <p>{f.onRequest}</p>
          <a class="link-arrow" href="#" onclick="return false">Demander le dossier complet<Icon name="arrow" size={16} /></a>
        </section>
        <p class="fa-disc">{f.disclaimer}</p>
      </div>
      <aside class="fb-card">
        <div class="fb-card__v">{p.pk ? <Fragment set:html={p.pk} /> : <img src={p.illu} alt="" />}</div>
        <div class="fb-card__b">
          <p class="fa-note"><span class={`fa-dot fa-dot--${p.x.family}`}></span>{p.st.badge}</p>
          <dl class="fb-card__facts">{p.facts.map((k) => <div><dt>{k.l}</dt><dd>{k.v}</dd></div>)}</dl>
          <a class="btn fb-card__btn" href="#" onclick="return false"><Icon name="download" size={18} />{f.download}</a>
          <a class="btn btn--ghost fb-card__btn" href="#" onclick="return false">Demander une cotation</a>
        </div>
      </aside>
    </div>
    <div class="fb-rel">
      <div class="wrap">
        <div class="fa-rel__h"><h2 class="fa-h">{f.related}</h2><a href="#" class="link-arrow" onclick="return false">{f.backRange}<Icon name="arrow" size={16} /></a></div>
        <ul class="fb-list">
          {p.related.slice(0, 6).map((r) => <li><a href="#" onclick="return false"><span class="fb-list__v">{r.pk ? <Fragment set:html={r.pk} /> : <img src={r.illu} alt="" />}</span><span><b>{r.name}</b><small>{r.f || r.badge}</small></span><Icon name="arrow" size={16} /></a></li>)}
        </ul>
      </div>
    </div>
  </div>
))}

<!-- ====================================================================== C -->
<section class="pl-intro" id="prop-c">
  <div class="wrap">
    <p class="pl-intro__k">Proposition C</p>
    <h2>Vitrine · produit mis en scène, rubriques en accordéon</h2>
    <div class="pl-intro__cols">
      <p>La plus spectaculaire. Le produit est mis en scène au centre d'un grand plateau clair, avec le nom en très grand. Ses informations clés flottent autour du visuel en étiquettes. Suit une bande bleu nuit « En bref » avec 4 chiffres, puis les rubriques en accordéon (la première ouverte) et un bandeau d'appel « Une question sur ce produit ? ».</p>
      <ul>
        <li><strong>Points forts :</strong> effet « produit phare », idéal pour les produits TILAMED quand les vraies photos arriveront.</li>
        <li><strong>Produits similaires :</strong> grille de 4 cartes compactes.</li>
        <li><strong>Limite :</strong> plus long à parcourir. Le grand plateau convient moins aux dispositifs médicaux, qui n'ont qu'une illustration.</li>
      </ul>
    </div>
  </div>
</section>
{products.map((p: P) => (
  <div class="fc" data-prod={p.id}>
    <div class="fc-stage">
      <div class="wrap">
        <p class="crumbs-pl">Accueil <span>/</span> Catalogue <span>/</span> {p.group} <span>/</span> <b>{p.name}</b></p>
        <p class="fc-eyebrow">{p.group} · {p.cat}</p>
        <h1 class="fc-title">{p.name}</h1>
        <p class="fc-lead">{p.use}</p>
        <div class="fc-scene">
          <ul class="fc-tags fc-tags--l">{p.facts.slice(0, 2).map((k) => <li><Icon name={k.icon} size={18} /><span><small>{k.l}</small>{k.v}</span></li>)}</ul>
          <div class="fc-v">{p.pk ? <Fragment set:html={p.pk} /> : <img src={p.illu} alt="" />}</div>
          <ul class="fc-tags fc-tags--r">{p.facts.slice(2, 4).map((k) => <li><Icon name={k.icon} size={18} /><span><small>{k.l}</small>{k.v}</span></li>)}</ul>
        </div>
        <div class="fc-ctas">
          <a class="btn" href="#" onclick="return false"><Icon name="download" size={18} />{f.download}</a>
          <a class="btn btn--ghost" href="#" onclick="return false">Demander une cotation</a>
        </div>
      </div>
    </div>
    <div class="fc-band">
      <div class="wrap">
        <p class="fc-band__h">{f.keyFacts}</p>
        <ul>
          <li><b>{p.formats[0]?.split(' · ')[0] ?? '—'}</b><span>{c.ui.formats}</span></li>
          <li><b>{p.x.route ?? (p.x.species ? f.speciesList[p.x.species as 'dog'] : p.cat)}</b><span>{p.x.route ? c.ui.route : p.x.species ? f.species : f.category}</span></li>
          <li><b>{p.x.pack ? c.packs[p.x.pack].replace(/^(Boîte|Carton) de /, '') : p.formats.length || '—'}</b><span>{p.x.pack ? c.ui.pack : 'Présentations'}</span></li>
          <li><b>{p.made ? `Phase ${p.x.phase ?? 1}` : 'Distribué'}</b><span>{p.made ? 'Production à Sèmè-Podji' : 'par TILAMED'}</span></li>
        </ul>
      </div>
    </div>
    <div class="fc-body">
      <div class="wrap fc-body__in">
        <details class="fc-acc" open><summary>{f.characteristics}<Icon name="chevron" size={20} /></summary><dl class="fa-spec">{p.specs.map(([l, v]) => <div><dt>{l}</dt><dd>{v}</dd></div>)}</dl></details>
        {p.texts.map((t) => <details class="fc-acc" data-full-only><summary>{t.label}<Icon name="chevron" size={20} /></summary><div class="fc-acc__b" set:html={rich(t.v)} /></details>)}
        <details class="fc-acc" data-full-only><summary>Documents à télécharger<Icon name="chevron" size={20} /></summary><ul class="fa-docs">{docs.map((d) => <li><a href="#" onclick="return false"><span class="fa-docs__ic"><Icon name="download" size={20} /></span><span><b>{d.t}</b><small>{d.d}</small></span><Icon name="arrow" size={16} /></a></li>)}</ul></details>
        <div class="fc-acc fc-acc--req" data-empty-only><p><b>{f.onRequestTitle}</b>{f.onRequest}</p></div>
        <p class="fa-disc">{f.disclaimer}</p>
      </div>
    </div>
    <div class="fc-cta">
      <div class="wrap fc-cta__in">
        <div><p class="fc-cta__t">{f.askTitle}</p><p>{f.askText}</p></div>
        <a class="btn btn--light" href="#" onclick="return false">Nous contacter</a>
      </div>
    </div>
    <div class="fc-rel">
      <div class="wrap">
        <div class="fa-rel__h"><h2 class="fa-h">{f.related}</h2><a href="#" class="link-arrow" onclick="return false">{f.backRange}<Icon name="arrow" size={16} /></a></div>
        <ul class="fc-grid">
          {p.related.slice(0, 4).map((r) => <li><a href="#" onclick="return false"><span class="fc-grid__v">{r.pk ? <Fragment set:html={r.pk} /> : <img src={r.illu} alt="" />}</span><b>{r.name}</b><small>{r.f || r.badge}</small></a></li>)}
        </ul>
      </div>
    </div>
  </div>
))}

<footer class="pl-end"><div class="wrap">Fin de la planche · textes « remplis » = exemples pour la maquette, pas des données du client.</div></footer>

